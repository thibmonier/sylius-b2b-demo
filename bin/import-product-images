#!/usr/bin/env php
<?php

declare(strict_types=1);

// US-196: imports the photos of fixtures/images/selection.json from a folder of originals (not versioned) into
// fixtures/images/*.webp and manifest.csv. Local files only: nothing is downloaded, and the same originals always give the same files.
//   php bin/import-product-images --source-dir=/path/to/originals [--selection=fixtures/images/selection.json] [--date=YYYY-MM-DD]

use App\Demo\Images\Fetch\ImageProcessor;
use App\Demo\Images\ImageManifest;
use App\Demo\Images\Import\PhotoCropper;
use App\Demo\Images\Import\PhotoSelection;
use App\Demo\Images\Import\SelectionImporter;

require \dirname(__DIR__) . '/vendor/autoload.php';

$projectDir = \dirname(__DIR__);
$imagesDir = $projectDir . '/fixtures/images';
$selectionPath = $imagesDir . '/selection.json';
$sourceDir = null;
$date = \date('Y-m-d');
foreach (\array_slice($argv, 1) as $argument) {
    if (\str_starts_with($argument, '--source-dir=')) {
        $sourceDir = \substr($argument, 13);
    } elseif (\str_starts_with($argument, '--selection=')) {
        $selectionPath = \substr($argument, 12);
    } elseif (\str_starts_with($argument, '--date=') && \preg_match('/^\d{4}-\d{2}-\d{2}$/', \substr($argument, 7)) === 1) {
        $date = \substr($argument, 7);
    } else {
        \fwrite(\STDERR, "usage: php bin/import-product-images --source-dir=DIR [--selection=FILE] [--date=YYYY-MM-DD]\n");
        exit(2);
    }
}
if ($sourceDir === null || !\is_dir($sourceDir)) {
    \fwrite(\STDERR, "--source-dir must name the folder of the original photos.\n");
    exit(2);
}
\ini_set('memory_limit', '1G');

try {
    $report = (new SelectionImporter(new ImageProcessor(), new PhotoCropper()))->import(
        PhotoSelection::load($selectionPath),
        $sourceDir,
        $imagesDir,
        ImageManifest::load($imagesDir . '/manifest.csv'),
        $date,
    );
} catch (\RuntimeException $exception) {
    \fwrite(\STDERR, $exception->getMessage() . "\n");
    exit(1);
}

\printf("photos: %d, SKUs: %d, orphan files removed: %d\n", $report['photos'], $report['skus'], \count($report['removed']));
