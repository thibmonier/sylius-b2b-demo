#!/bin/sh
# Rebases the current feature branch on origin/main and publishes an up-to-date proof (T-TECH-30-02, action 1 of the
# retrospectives of sprints 27 to 29). Parallel pull requests all touch config/demo/proof.json: a conflict on that file
# alone is resolved by taking main's version and regenerating it; a conflict on any other file aborts the rebase and
# leaves the branch as it was. The proof is then regenerated by bin/proof-refresh, verified by bin/proof-check and
# committed when it changed. Nothing is pushed: push with `git push --force-with-lease` after reading the log.
#
#   bin/proof-rebase            # on the checked-out feature branch, clean tree
#   PROOF_REBASE_TRAILERS="Co-Authored-By: ..." bin/proof-rebase   # trailers appended to the proof commit
#
# Exit codes: 0 rebased and proof up to date, 1 conflict outside the proof or proof check failed, 2 refused (dirty
# tree, main branch, detached head, rebase already in progress). See docs/tests-locaux.md.
set -eu
cd "$(dirname "$0")/.."

PROOF=config/demo/proof.json
MESSAGE="chore(proof): preuve publiée à jour après rebase sur main"

BRANCH=$(git symbolic-ref --quiet --short HEAD || true)
GIT_DIR=$(git rev-parse --git-dir)
if [ -z "$BRANCH" ]; then
    echo "No branch checked out (detached head): check out the feature branch first." >&2
    exit 2
fi
if [ "$BRANCH" = main ]; then
    echo "On main: bin/proof-rebase rebases a feature branch on origin/main, never main itself." >&2
    exit 2
fi
if [ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ]; then
    echo "A rebase is already in progress: finish it or run git rebase --abort first." >&2
    exit 2
fi
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "The tree has uncommitted changes: commit them (exact paths) or wait for the worker who owns them." >&2
    git status --short --untracked-files=no >&2
    exit 2
fi

git fetch --quiet origin main
echo "== Rebase of $BRANCH on origin/main"
if ! git -c core.editor=true rebase --quiet origin/main >/dev/null 2>&1; then
    while [ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ]; do
        CONFLICTS=$(git diff --name-only --diff-filter=U)
        if [ "$CONFLICTS" != "$PROOF" ]; then
            git rebase --abort
            echo "Conflict outside the proof, rebase aborted, $BRANCH left as it was:" >&2
            echo "$CONFLICTS" >&2
            exit 1
        fi
        git checkout --quiet origin/main -- "$PROOF"
        bin/proof-refresh >/dev/null
        git add -- "$PROOF"
        GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
    done
fi

echo "== Proof"
bin/proof-refresh >/dev/null
if ! git diff --quiet -- "$PROOF"; then
    git commit --quiet -m "$MESSAGE" ${PROOF_REBASE_TRAILERS:+-m "$PROOF_REBASE_TRAILERS"} -- "$PROOF"
    echo "committed: $MESSAGE"
fi
if ! bin/proof-check; then
    echo "bin/proof-check still fails after the refresh: read its output before pushing." >&2
    exit 1
fi
git log --oneline -3
echo "Rebased on origin/main. Push with: git push --force-with-lease origin $BRANCH"
