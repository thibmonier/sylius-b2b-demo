#!/usr/bin/env php
<?php

declare(strict_types=1);

// US-239: weekly versions report for the demo stack. Compares installed versions
// (composer.lock, package.json, Docker images) against the latest published versions
// and generates a structured Markdown issue body.
//
// Usage:
//   bin/stack-versions-report

require dirname(__DIR__) . '/vendor/autoload.php';

use App\Demo\Stack\DockerHubPhpUpgradeWatchSource;
use App\Demo\Stack\GhPluginRepositoriesSource;
use App\Demo\Stack\IgnoredUpdates;
use App\Demo\Stack\ShellOutdatedSource;
use App\Demo\Stack\VersionsReport;
use Symfony\Component\HttpClient\HttpClient;

// The plugins follow the same weekly watch as the demo (2026-11-03): config/demo/plugin-repositories.json lists them.
$repositories = json_decode((string) file_get_contents(dirname(__DIR__) . '/config/demo/plugin-repositories.json'), true, flags: \JSON_THROW_ON_ERROR);
$plugins = new GhPluginRepositoriesSource($repositories['owner'], $repositories['repositories']);
// ADR-0021: the PHP 8.6 gate is re-checked every week rather than re-investigated by hand.
$phpUpgrade = new DockerHubPhpUpgradeWatchSource(HttpClient::create(), dirname(__DIR__) . '/composer.lock');
// 2026-11-22: packages left out on purpose (Composer, npm, Docker) come from one file instead of coming back every week.
$ignored = IgnoredUpdates::fromFile(dirname(__DIR__) . '/config/demo/version-watch-ignore.json', new DateTimeImmutable());
$report = new VersionsReport(new ShellOutdatedSource(), plugins: $plugins, owner: $repositories['owner'], phpUpgrade: $phpUpgrade, ignored: $ignored);

echo $report->generate();
