#!/bin/sh
# Frees the disk space taken by local test runs (US-141, scoped per worker by US-161): the private caches var/cache-*,
# the test databases of the local MySQL container and its binary logs. Shows `df -h .` before and after. The default
# test database (sylius_b2b_demo_test) and the development database (sylius_b2b_demo) are never touched. The threshold
# MIN_FREE_GB of bin/run-tests is never lowered: when it blocks, run this script (or ask for help), do not bypass it.
#
# Several workers share the same MySQL and the same var/: a worker removes only what carries its own identifier.
#
#   WORKER_ID=wf bin/clean-test-caches            # removes var/cache-wf, var/cache-wf-*, b2b_wf, b2b_wf_*, sylius_test_wf
#   WORKER_ID=wf bin/clean-test-caches --dry-run  # lists them, removes nothing
#   bin/clean-test-caches --all                   # orchestrator only, outside any batch: every worker's resources
#   MYSQL_CONTAINER=name bin/clean-test-caches ...   # default: sylius-b2b-demo-mysql-1
#
# WORKER_ID is letters and digits only (no underscore: b2b_a_* must not match the worker "a_b"). Without WORKER_ID nor
# --all the script refuses (exit 2); --all together with WORKER_ID is refused (exit 5: a worker never cleans for the
# others). A real run is refused (exit 3) while a bin/run-tests of the same scope is active: it reads the lock, a stale
# lock does not count; --all is refused while any run is active, a worker is refused only for its own run.
# --all matches sylius_test_*, b2b_*, sylius_b2b_demo_test_*. See docs/tests-locaux.md.
set -eu
cd "$(dirname "$0")/.."

DRY_RUN=0
ALL=0
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=1 ;;
        --all) ALL=1 ;;
        *) echo "Usage: [WORKER_ID=<worker>] bin/clean-test-caches [--all] [--dry-run]" >&2; exit 2 ;;
    esac
done

WORKER="${WORKER_ID:-}"
case "$WORKER" in
    *[!A-Za-z0-9]*) echo "WORKER_ID must only contain letters and digits." >&2; exit 2 ;;
esac
if [ "$ALL" = 1 ] && [ -n "$WORKER" ]; then
    echo "--all is reserved to the orchestrator: unset WORKER_ID (a worker cleans only its own resources)." >&2
    exit 5
fi
if [ "$ALL" = 0 ] && [ -z "$WORKER" ]; then
    echo "Set WORKER_ID=<worker> to clean your own resources, or use --all (orchestrator only, outside any batch)." >&2
    exit 2
fi

CONTAINER="${MYSQL_CONTAINER:-sylius-b2b-demo-mysql-1}"
KEEP_DB="sylius_b2b_demo_test"

LOCK_DIR="${RUN_TESTS_LOCK:-var/run-tests.lock}"
RUN_PID=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
RUN_WORKER=$(cat "$LOCK_DIR/worker" 2>/dev/null || true)
RUN_ALIVE=0
if [ -d "$LOCK_DIR" ] && { [ -z "$RUN_PID" ] || kill -0 "$RUN_PID" 2>/dev/null; }; then RUN_ALIVE=1; fi
if [ "$DRY_RUN" = 0 ] && [ "$RUN_ALIVE" = 1 ] && { [ "$ALL" = 1 ] || [ -z "$RUN_WORKER" ] || [ "$RUN_WORKER" = "$WORKER" ]; }; then
    echo "bin/run-tests is running (PID ${RUN_PID:-unknown}): its caches and database would be removed under it. Wait for it, or use --dry-run." >&2
    exit 3
fi

# True when the name belongs to the scope of this run: everything for --all, only the worker's own otherwise.
cache_in_scope() {
    [ "$ALL" = 1 ] && return 0
    case "$1" in "var/cache-$WORKER"|"var/cache-$WORKER-"*) return 0 ;; esac
    return 1
}
db_in_scope() {
    if [ "$ALL" = 1 ]; then
        case "$1" in sylius_test_*|b2b_*|sylius_b2b_demo_test_*) return 0 ;; esac
        return 1
    fi
    case "$1" in "b2b_$WORKER"|"b2b_${WORKER}_"*|"sylius_test_$WORKER"|"sylius_test_${WORKER}_"*) return 0 ;; esac
    return 1
}

if [ "$DRY_RUN" = 1 ]; then echo "[dry-run] nothing will be removed."; fi
echo "== Disk before"; df -h .

echo "== Test caches (var/cache-*)"
FOUND=0
for dir in var/cache-*; do
    [ -d "$dir" ] || continue
    cache_in_scope "$dir" || continue
    FOUND=1
    if [ "$DRY_RUN" = 1 ]; then echo "would remove $dir"; else rm -rf "$dir"; echo "removed $dir"; fi
done
[ "$FOUND" = 1 ] || echo "none"

mysql_exec() { docker exec "$CONTAINER" mysql -uroot -N -B -e "$1"; }

echo "== Stale test databases ($CONTAINER)"
if ! DATABASES=$(mysql_exec 'SHOW DATABASES' 2>/dev/null); then
    echo "MySQL container not reachable: databases and binary logs skipped."
else
    FOUND=0
    for db in $DATABASES; do
        if [ "$db" = "$KEEP_DB" ]; then
            [ "$ALL" = 1 ] && echo "kept $db (default test database)"
            continue
        fi
        db_in_scope "$db" || continue
        FOUND=1
        if [ "$DRY_RUN" = 1 ]; then echo "would drop $db"; else mysql_exec "DROP DATABASE \`$db\`"; echo "dropped $db"; fi
    done
    [ "$FOUND" = 1 ] || echo "none"

    echo "== Binary logs"
    if [ "$DRY_RUN" = 1 ]; then
        mysql_exec 'SHOW BINARY LOGS' 2>/dev/null | awk '{print "would purge " $1 " (" $2 " bytes)"}' || true
    else
        mysql_exec 'PURGE BINARY LOGS BEFORE NOW()' 2>/dev/null && echo "purged" || echo "no binary log to purge"
    fi
fi

echo "== Disk after"; df -h .
