#!/bin/sh
# Runs the test suite with a private, throwaway cache (US-055 / T-055-02). A stale compiled container (a constructor
# changed since the last run) used to cause false failures: every run now gets an empty cache of its own, removed at the end.
#
#   bin/run-tests                                  # full suite, database sylius_b2b_demo_test
#   bin/run-tests tests/Functional --filter Quote  # arguments go to PHPUnit
#   TEST_DB_NAME=b2b_mine bin/run-tests
#   TEST_CACHE_DIR=var/cache-mine bin/run-tests    # your own cache directory (emptied before, removed after)
#
# Holds a lock (RUN_TESTS_LOCK, default var/run-tests.lock): a second run is refused at once (exit 4) while the first one
# lives; a lock left by a dead process is taken over atomically (renamed away, then recreated) and logged in
# var/run-tests.log. The lock records the PID and, when set, WORKER_ID (read by bin/clean-test-caches).
#
#   bin/run-tests --wait                           # waits for the end of the current run, runs nothing
#
# --wait reads the lock (never pgrep): it returns 0 at once when no live run holds it, and gives up with exit 5 and a
# report after RUN_TESTS_WAIT_TIMEOUT seconds (default 1800 = 30 min), polling every RUN_TESTS_WAIT_INTERVAL seconds (5).
#
# Stops without creating anything when less than MIN_FREE_GB (5) GB are free (never lowered); bin/check-disk shows the
# free space and alerts below 15 GB. Prepares the database through bin/prepare-test-db, so it never touches the
# development database (sylius_b2b_demo). See docs/tests-locaux.md.
set -eu
cd "$(dirname "$0")/.."

LOCK_DIR="${RUN_TESTS_LOCK:-var/run-tests.lock}"

if [ "${1:-}" = "--wait" ]; then
    TIMEOUT="${RUN_TESTS_WAIT_TIMEOUT:-1800}"
    INTERVAL="${RUN_TESTS_WAIT_INTERVAL:-5}"
    START=$(date +%s)
    while :; do
        HOLDER=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
        if [ ! -d "$LOCK_DIR" ] || { [ -n "$HOLDER" ] && ! kill -0 "$HOLDER" 2>/dev/null; }; then
            exit 0
        fi
        if [ $(($(date +%s) - START)) -ge "$TIMEOUT" ]; then
            echo "Gave up after ${TIMEOUT}s: bin/run-tests is still running (PID ${HOLDER:-unknown}, lock $LOCK_DIR). Report it, do not retry blindly." >&2
            exit 5
        fi
        sleep "$INTERVAL"
    done
fi

MIN_FREE_GB="${MIN_FREE_GB:-5}"
FREE_KB=$(df -Pk . | awk 'NR==2 {print $4}')
if [ "$FREE_KB" -lt $((MIN_FREE_GB * 1024 * 1024)) ]; then
    echo "Only $((FREE_KB / 1024 / 1024)) GB free, at least ${MIN_FREE_GB} GB required: clean up before running the suite." >&2
    exit 1
fi

DB_NAME="${TEST_DB_NAME:-sylius_b2b_demo_test}"
case "$DB_NAME" in
    ''|*[!A-Za-z0-9_]*) echo "TEST_DB_NAME must only contain letters, digits and underscores." >&2; exit 1 ;;
    sylius_b2b_demo) echo "Refusing to use the development database \"sylius_b2b_demo\"." >&2; exit 1 ;;
esac

[ ! -x bin/check-disk ] || bin/check-disk || true

CACHE_DIR=""
LOCK_HELD=0
cleanup() {
    [ -z "$CACHE_DIR" ] || rm -rf "$CACHE_DIR"
    if [ "$LOCK_HELD" = 1 ]; then rm -rf "$LOCK_DIR"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Atomic: mkdir either creates the lock or fails. A lock whose PID is gone is stale: it is renamed to a name unique to
# this run (a rename is atomic, only one run can move it), then the lock is created again with mkdir. A run that moved a
# lock which is no longer the one it judged stale (another run took it over in between) puts it back.
LOG_FILE="${RUN_TESTS_LOG:-var/run-tests.log}"
mkdir -p "$(dirname "$LOCK_DIR")"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    HOLDER=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
    if [ -z "$HOLDER" ] || kill -0 "$HOLDER" 2>/dev/null; then
        echo "bin/run-tests is already running (PID ${HOLDER:-unknown}, lock $LOCK_DIR): wait for it to finish, then retry." >&2
        exit 4
    fi
    ASIDE="$LOCK_DIR.stale.$$"
    if mv "$LOCK_DIR" "$ASIDE" 2>/dev/null; then
        MOVED=$(cat "$ASIDE/pid" 2>/dev/null || true)
        if [ "$MOVED" != "$HOLDER" ]; then
            [ -e "$LOCK_DIR" ] || mv "$ASIDE" "$LOCK_DIR" 2>/dev/null || true
            echo "bin/run-tests is already running (lock $LOCK_DIR taken over by another run): wait for it to finish, then retry." >&2
            exit 4
        fi
        rm -rf "$ASIDE"
        echo "Stale lock of PID $HOLDER taken over." >&2
        echo "$(date '+%Y-%m-%dT%H:%M:%S') stale lock taken over (previous PID $HOLDER, new PID $$)" >> "$LOG_FILE"
    fi
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        echo "bin/run-tests is already running (lock $LOCK_DIR taken by another run): wait for it to finish, then retry." >&2
        exit 4
    fi
fi
LOCK_HELD=1
echo "$$" > "$LOCK_DIR/pid"
[ -z "${WORKER_ID:-}" ] || echo "$WORKER_ID" > "$LOCK_DIR/worker"

if [ -n "${TEST_CACHE_DIR:-}" ]; then
    CACHE_DIR="$TEST_CACHE_DIR"
    mkdir -p "$(dirname "$CACHE_DIR")"
    RESOLVED="$(cd "$(dirname "$CACHE_DIR")" && pwd)/$(basename "$CACHE_DIR")"
    case "$RESOLVED" in
        "$PWD/var/cache"|"$PWD"|"$PWD/var"|"$HOME"|//*|/) CACHE_DIR=""; echo "Refusing to empty \"$TEST_CACHE_DIR\": use a dedicated directory." >&2; exit 1 ;;
    esac
    rm -rf "$CACHE_DIR"
else
    CACHE_DIR=$(mktemp -d "${TMPDIR:-/tmp}/b2b-test-cache.XXXXXX")
fi

export TEST_DB_NAME="$DB_NAME"
export TEST_CACHE_DIR="$CACHE_DIR"
bin/prepare-test-db

# Same environment as bin/prepare-test-db, so the tests hit the database it just loaded and the same cache.
export APP_ENV=test
export APP_CACHE_DIR="$CACHE_DIR"
export APP_LOG_DIR="$CACHE_DIR/log"
export APP_SHARE_DIR="$CACHE_DIR/share"
export DATABASE_URL="${TEST_DATABASE_URL:-mysql://root@127.0.0.1:${MYSQL_PORT:-3340}/${DB_NAME}?serverVersion=8.4&charset=utf8mb4}"
export WKHTMLTOPDF_BINARY="$PWD/tests/Fixtures/bin/fake-wkhtmltopdf"

# No exec: the trap must run after PHPUnit. Its exit code is the script's. PHPUnit runs in the background and the
# script waits for it: a POSIX shell (dash) runs a trap only once its foreground child ends, while `wait` is
# interrupted by the signal, so a terminated run stops PHPUnit and removes its lock at once.
php -d memory_limit=-1 vendor/bin/phpunit "$@" &
PHPUNIT_PID=$!
trap 'kill "$PHPUNIT_PID" 2>/dev/null || true; exit 130' INT
trap 'kill "$PHPUNIT_PID" 2>/dev/null || true; exit 143' TERM
wait "$PHPUNIT_PID"
