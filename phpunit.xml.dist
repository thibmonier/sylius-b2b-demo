<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />

        <!-- ###+ symfony/framework-bundle ### -->
        <env name="APP_DEBUG" value="0"/>
        <env name="APP_ENV" value="test"/>
        <env name="DEMO_MODE" value="1" force="true"/>
        <!-- The private gate and the PunchOut endpoint guard are exercised by their own tests (tests/Functional/Demo). -->
        <env name="DEMO_BASIC_AUTH" value="0" force="true"/>
        <env name="DEMO_PUNCHOUT_PUBLIC_ENDPOINT" value="1" force="true"/>
        <!-- Rate limits out of the way of the suite; the hardening tests lower them (tests/Functional/Demo). -->
        <env name="DEMO_RATE_LIMIT_GATE" value="100000" force="true"/>
        <env name="DEMO_RATE_LIMIT_API_AUTH" value="100000" force="true"/>
        <env name="DEMO_RATE_LIMIT_API_WRITE" value="100000" force="true"/>
        <env name="DEMO_RATE_LIMIT_MCP" value="100000" force="true"/>
        <!-- The fail-closed checks of the demo mode (app:demo:preflight) want a real secret and a host whitelist (any plain host name here, the tests use localhost and shop.test). -->
        <env name="APP_SECRET" value="test-secret-of-at-least-32-characters-long" force="true"/>
        <env name="TRUSTED_HOSTS" value="^[a-z0-9.-]+$" force="true"/>
        <env name="DEMO_RATE_LIMIT_LOGIN" value="100000" force="true"/>
        <env name="DEMO_RATE_LIMIT_PUBLIC" value="100000" force="true"/>
        <env name="DEMO_RATE_LIMIT_FORMS" value="100000" force="true"/>
        <env name="DEMO_RATE_LIMIT_PUNCHOUT_START" value="100000" force="true"/>
        <env name="DEMO_RATE_LIMIT_PUNCHOUT_ORDER" value="100000" force="true"/>
        <env name="DEMO_MAILPIT_URL" value="http://localhost:8025" force="true"/>
        <server name="SHELL_VERBOSITY" value="-1" />
        <!-- ###- symfony/framework-bundle ### -->

        <server name="IS_DOCTRINE_ORM_SUPPORTED" value="true" />
        <server name="ESCAPE_JSON" value="true" />

        <server name="KERNEL_CLASS" value="App\Kernel" />
    </php>

    <testsuites>
        <testsuite name="Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
