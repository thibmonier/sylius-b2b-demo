{
    "name": "thibmonier/sylius-b2b-demo",
    "type": "project",
    "description": "B2B demo of Sylius 2.3 with the tmonier plugins",
    "keywords": [
        "symfony",
        "sylius",
        "distribution",
        "ecommerce",
        "cart",
        "shopping"
    ],
    "homepage": "https://sylius.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Paweł Jędrzejewski"
        },
        {
            "name": "Sylius project"
        },
        {
            "name": "Community contributions"
        }
    ],
    "require": {
        "php": "^8.5",
        "dompdf/dompdf": "^3.1.6",
        "sylius/invoicing-plugin": "^2.3",
        "sylius/mcp-server-plugin": "^0.2",
        "sylius/refund-plugin": "^2.2.1",
        "sylius/sylius": "^2.3.2",
        "sylius/wishlist-plugin": "1.4.x-dev",
        "symfony/ai-bundle": "^0.14.1",
        "symfony/dotenv": "^8.1.6",
        "symfony/flex": "^2.11",
        "symfony/process": "^8.1.9",
        "symfony/runtime": "^8.1.9",
        "tmonier/sylius-admin-order-creation-plugin": "^1.1",
        "tmonier/sylius-agentic-feeds-plugin": "^1.0",
        "tmonier/sylius-ai-catalog-copilot-plugin": "^1.0",
        "tmonier/sylius-audit-log-plugin": "^1.0",
        "tmonier/sylius-b2b-mcp-plugin": "^1.2.2",
        "tmonier/sylius-bulk-actions-plugin": "^1.0",
        "tmonier/sylius-channel-access-plugin": "^0.2",
        "tmonier/sylius-command-palette-plugin": "^1.1.0",
        "tmonier/sylius-company-accounts-plugin": "^1.3",
        "tmonier/sylius-company-insights-plugin": "^0.2",
        "tmonier/sylius-container-fill-plugin": "^1.1.1",
        "tmonier/sylius-customer-asset-management-plugin": "^0.1.1",
        "tmonier/sylius-einvoice-transmission-plugin": "^0.2",
        "tmonier/sylius-erp-flatfile-plugin": "^0.2",
        "tmonier/sylius-facturx-plugin": "^1.1",
        "tmonier/sylius-gpsr-plugin": "^1.0",
        "tmonier/sylius-order-hold-plugin": "^1.0",
        "tmonier/sylius-punchout-cxml-plugin": "^1.3.0",
        "tmonier/sylius-purchase-approval-plugin": "^1.4",
        "tmonier/sylius-quick-order-plugin": "^1.3.0",
        "tmonier/sylius-quote-request-plugin": "^1.1.0",
        "tmonier/sylius-registration-approval-plugin": "^0.1.2",
        "tmonier/sylius-tier-pricing-plugin": "^1.1",
        "tmonier/sylius-timeline-plugin": "^1.0",
        "tmonier/sylius-trade-credit-plugin": "^1.1",
        "tmonier/sylius-webhook-outbox-plugin": "^1.0",
        "tmonier/sylius-withdrawal-plugin": "^1.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8.2",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.1",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^13.4.5",
        "sylius-labs/coding-standard": "^4.5.1",
        "sylius/sylius-rector": "^3.9",
        "symfony/browser-kit": "^8.1.9",
        "symfony/contracts": "^3.7.3",
        "symfony/css-selector": "^8.1.6",
        "symfony/debug-bundle": "^8.1.0",
        "symfony/http-client": "^8.1.9",
        "symfony/intl": "^8.1.5",
        "symfony/web-profiler-bundle": "^8.1.9"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": false,
            "rector/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "symfony/thanks": false
        },
        "bump-after-update": true,
        "platform": {
            "php": "8.5.12"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.1.*",
            "endpoint": [
                "https://api.github.com/repos/Sylius/SyliusRecipes/contents/index.json?ref=flex/main",
                "flex://defaults"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        },
        "classmap": [
            "src/Kernel.php"
        ]
    },
    "prefer-stable": true,
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "post-create-project-cmd": [
            "@remove-lockfiles-from-gitignore",
            "@php bin/console sylius:inform-about-gus --ansi",
            "@php bin/console sylius:show-plus-info --ansi"
        ],
        "remove-lockfiles-from-gitignore": "@php -r \"file_put_contents('.gitignore', str_replace(['/composer.lock' . PHP_EOL, '/yarn.lock' . PHP_EOL], '', file_get_contents('.gitignore')));\"",
        "rector-dry-run": "vendor/bin/rector process --dry-run",
        "rector-apply": "vendor/bin/rector process",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "suggest": {
        "sylius/sylius-ai-dev-tools": "Dev-only AI tooling pack for Sylius: bundles Mate extension and Sylius skills."
    },
    "replace": {
        "symfony/polyfill-apcu": "*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-intl": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-icu": "*",
        "symfony/polyfill-intl-idn": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "minimum-stability": "beta"
}
