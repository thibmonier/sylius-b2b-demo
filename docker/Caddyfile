{
	# TLS is terminated by Railway (and plain HTTP locally).
	auto_https off
	admin off

	# Bounded PHP threads (ADR-0013): without num_threads/max_threads FrankenPHP starts 2 x the CPU count of the
	# host (16 on Railway) and may grow past it. max_threads caps the memory the PHP pool can take.
	frankenphp {
		num_threads {$FRANKENPHP_NUM_THREADS:8}
		max_threads {$FRANKENPHP_MAX_THREADS:16}
	}
}

:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip

	# HSTS only when the visitor really is on HTTPS (Railway terminates TLS and says so); the application sets
	# the same headers on its own responses, Caddy covers the static files it serves directly.
	@https header X-Forwarded-Proto https
	header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	# Hidden files and directories (dotfiles) are never served; /.well-known/ stays reachable.
	@hidden {
		path_regexp hidden (^|/)\.
		not path /.well-known/*
	}
	respond @hidden 404

	@static path /build/* /bundles/* /media/*
	header @static Cache-Control "public, max-age=604800"

	# Body ceiling of the public webhook receiver (US-049). Without it a chunked body (no Content-Length to look at) is
	# read whole by PHP before its size check. Under FrankenPHP Caddy does not answer 413 itself: it cuts the stream
	# and PHP reads at most max_size bytes. The value is WebhookReceiverController::MAX_BODY_BYTES + 1, so that a
	# body over the ceiling still reaches the controller's own `strlen > MAX_BODY_BYTES` test and is answered 413
	# (tests/Unit/Docker/CaddyfileTest.php keeps the two aligned, bin/check-caddy-body-limit proves the cut on the image).
	@webhookReceiver path /demo/webhooks/receive
	request_body @webhookReceiver {
		max_size 262145
	}

	# Worker mode (ADR-0013) is opt-in: entrypoint.sh fills FRANKENPHP_WORKER_DIRECTIVE when FRANKENPHP_WORKER_MODE=1,
	# otherwise the line expands to nothing and the classic mode applies.
	php_server {
		{$FRANKENPHP_WORKER_DIRECTIVE:}
	}
}
