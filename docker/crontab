# Scheduled tasks of the demo (US-004), run by supercronic inside the web container (ADR-0002).
# Times are Europe/Paris, daylight saving time included: CRON_TZ is read by supercronic itself (the image
# sets TZ=Europe/Paris too, the explicit line keeps a run outside the image on Paris time).
CRON_TZ=Europe/Paris

# Outgoing webhooks (webhook-outbox): every minute, bounded
* * * * * php /app/bin/console tmonier:webhook:dispatch --time-limit=55 --quiet

# Product feeds for AI assistants (agentic-feeds)
*/15 * * * * php /app/bin/console tmonier:feeds:generate --stale --quiet
30 4 * * * php /app/bin/console tmonier:feeds:generate --quiet

# Expirations, reminders and recalculations
15 4 * * * php /app/bin/console tmonier:approval:expire --no-interaction
20 4 * * * php /app/bin/console tmonier:quote-request:expire --no-interaction
25 4 * * * php /app/bin/console tmonier:trade-credit:send-reminders --no-interaction
30 4 * * * php /app/bin/console tmonier:predictive:recalculate --no-interaction
35 4 * * * php /app/bin/console tmonier:trade-credit:recalculate --apply --no-interaction

# Purges
40 4 * * * php /app/bin/console tmonier:punchout:purge --no-interaction
42 4 * * * php /app/bin/console tmonier:webhook:purge --no-interaction
44 4 * * * php /app/bin/console tmonier:audit-log:purge --no-interaction
46 4 * * * php /app/bin/console tmonier:b2b-mcp:purge --no-interaction
48 4 * * * php /app/bin/console tmonier:admin-order:purge-drafts --no-interaction

# Nightly demo reset (US-012, US-033) at 03:00 Paris time — full purge + fixture reload (one transaction) + cache
# warm-up. No redirection: supercronic forwards the stdout (DEMO_RESET_OK) and the stderr (DEMO_RESET_FAILED) of the
# job to the container logs, where Railway shows them, and logs the non-zero exit code. It ends well before the
# 04:xx tasks and the 03:xx slot is empty.
0 3 * * * php -d memory_limit=1G /app/bin/console app:demo:reset --no-interaction

# Sylius core
50 4 * * * php /app/bin/console sylius:remove-expired-carts --no-interaction
55 4 * * * php /app/bin/console sylius:cancel-unpaid-orders --no-interaction
