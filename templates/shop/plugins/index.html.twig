{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'app.plugins.title'|trans }}{% endblock %}

{% block content %}
    <div class="container my-5" data-page="plugins">
        <h1>{{ 'app.plugins.title'|trans }}</h1>
        <p class="lead">{{ 'app.plugins.intro'|trans({'%count%': demo_plugin_count()}) }}</p>
        {% if demo_mode() %}
            <p><a href="{{ path('app_demo_punchout_simulator', {lang: app.request.locale|slice(0, 2)}) }}" data-punchout-simulator-link{{ app_umami_event('simulateur-punchout-ouverture', { emplacement: 'plugins' }) }}>{{ 'plugins_link'|trans({}, 'simulator') }}</a></p>
        {% endif %}

        {% include 'shared/_contact_cta.html.twig' with { variant: 'banner', placement: 'plugins-top' } only %}

        {% for category, plugins in groups %}
            <section class="mt-5" data-plugin-category="{{ category }}">
                <h2 class="h4 border-bottom pb-2 b2b-section-title">{{ ('app.plugins.category.' ~ category)|trans }}</h2>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 mt-1">
                    {% for plugin in plugins %}
                        <div class="col">
                            <article class="card h-100" id="plugin-{{ plugin.slug }}" data-plugin="{{ plugin.slug }}">
                                <div class="card-body">
                                    <h3 class="h5 card-title">{{ plugin.name }}</h3>
                                    <p class="card-text">{{ plugin.description(app.request.locale) }}</p>
                                    <p class="card-text small" data-plugin-scenario><strong>{{ 'app.plugins.scenario'|trans }}</strong> {{ plugin.scenario(app.request.locale) }}</p>
                                    <p class="card-text small" data-plugin-account><strong>{{ 'app.plugins.advised_account'|trans }}</strong> <code>{{ plugin.advisedAccount }}</code></p>
                                </div>
                                <div class="card-footer d-flex flex-wrap align-items-center gap-3 px-3 py-2 bg-transparent">
                                    {% include 'shared/_external_link.html.twig' with { url: plugin.githubUrl, label: 'app.plugins.github'|trans } only %}
                                    {% if plugin.packagistUrl is not null %}
                                        {% include 'shared/_external_link.html.twig' with { url: plugin.packagistUrl, label: 'app.plugins.packagist'|trans, data_attribute: 'data-plugin-packagist' } only %}
                                    {% else %}
                                        <span class="badge text-bg-secondary align-self-center" data-plugin-unpublished data-plugin-status="{{ plugin.status }}">{{ ('app.plugins.status.' ~ plugin.status)|trans }}</span>
                                    {% endif %}
                                    {% if plugin.demoRoute is not null %}
                                        <a href="{{ path(plugin.demoRoute, {_locale: app.request.locale}) }}" data-plugin-demo-link>{{ 'app.plugins.see_in_demo'|trans }}</a>
                                    {% else %}
                                        <span class="text-muted">{{ 'app.plugins.no_demo_page'|trans }}</span>
                                    {% endif %}
                                    {% include 'shared/_contact_cta.html.twig' with { variant: 'link', placement: 'plugin-' ~ plugin.slug, context: plugin.name } only %}
                                    {% if plugin.slug == 'sylius-b2b-mcp-plugin' %}
                                        <a href="{{ path('app_demo_mcp_guide', {_locale: app.request.locale}) }}" data-plugin-guide-link{{ app_umami_event('guide-mcp', { emplacement: 'plugins' }) }}>{{ 'app.plugins.mcp_guide'|trans }}</a>
                                    {% endif %}
                                </div>
                            </article>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}

        {% include 'shared/_contact_cta.html.twig' with { variant: 'banner', placement: 'plugins-bottom' } only %}

        {# US-104 (decision D2): factual sentence only, no comparison with the official offering. #}
        <p class="text-muted mt-5 mb-0" data-plugins-compat-note>{{ 'app.plugins.sylius_version'|trans }}</p>
    </div>
{% endblock %}
