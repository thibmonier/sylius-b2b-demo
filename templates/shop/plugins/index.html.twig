{#
    US-204: the public "Plugins" page, in the editorial look of the B2B home (validated mock-up of 2026-10-27): introduction,
    links to the other presentation pages, then one section per family with a card per plugin (name, role, badges drawn from
    the proof file, links to the code). Only the listed plugins are shown (the ERP plugin is not, decision of 2026-10-27).
    No text of its own: everything comes from the `plugins` domain. The page serves both channels: the classes of the B2B
    stylesheet only style the B2B one, the markup stays readable on the other.
#}
{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'app.plugins.title'|trans }}{% endblock %}

{% block content %}
    {% set sylius_version = '2.3' %}
    <div data-page="plugins">
        <section class="b2b-home-section b2b-plugins-intro" aria-labelledby="plugins-title">
            <div class="b2b-home-wrap">
                <p class="b2b-home-eyebrow">{{ 'eyebrow'|trans({}, 'plugins') }}</p>
                <h1 id="plugins-title" class="b2b-home-h1">{{ 'title_start'|trans({}, 'plugins') }} <span class="b2b-home-h1__accent">{{ 'title_accent'|trans({}, 'plugins') }}</span></h1>
                <p class="b2b-home-lead" data-plugins-intro>{{ 'lead'|trans({}, 'plugins') }}</p>
                {% include 'shared/_contact_cta.html.twig' with { variant: 'link', placement: 'plugins-top' } only %}
                <nav class="b2b-plugins-chips" aria-label="{{ 'families.label'|trans({}, 'plugins') }}" data-plugins-families>
                    {% for category, plugins in groups %}
                        <a class="b2b-plugins-chip" href="#famille-{{ category }}" data-plugins-family-link="{{ category }}">{{ ('families.' ~ category)|trans({}, 'plugins') }} <span class="b2b-plugins-chip__count">{{ plugins|length }}</span></a>
                    {% endfor %}
                </nav>
            </div>
        </section>

        <section class="b2b-home-section b2b-home-section--sand b2b-plugins-more" aria-label="{{ 'more.label'|trans({}, 'plugins') }}">
            <div class="b2b-home-wrap">
                <ul class="b2b-plugins-tiles">
                    <li><a class="b2b-plugins-tile" href="{{ path('app_demo_integrate', {_locale: app.request.locale}) }}" data-plugins-integrate-link><strong class="b2b-home-serif">{{ 'more.integrate.title'|trans({}, 'plugins') }}</strong><span>{{ 'more.integrate.text'|trans({}, 'plugins') }}</span></a></li>
                    <li><a class="b2b-plugins-tile" href="{{ path('app_demo_proof', {_locale: app.request.locale}) }}" data-plugins-proof-link><strong class="b2b-home-serif">{{ 'more.proof.title'|trans({}, 'plugins') }}</strong><span>{{ 'more.proof.text'|trans({}, 'plugins') }}</span></a></li>
                    <li><a class="b2b-plugins-tile" href="{{ path('app_demo_compatibility', {_locale: app.request.locale}) }}" data-plugins-compat-link><strong class="b2b-home-serif">{{ 'more.compatibility.title'|trans({}, 'plugins') }}</strong><span>{{ 'more.compatibility.text'|trans({}, 'plugins') }}</span></a></li>
                    {% if demo_mode() %}
                        <li><a class="b2b-plugins-tile" href="{{ path('app_demo_punchout_simulator', {lang: app.request.locale|slice(0, 2)}) }}" data-punchout-simulator-link{{ app_umami_event('simulateur-punchout-ouverture', { emplacement: 'plugins' }) }}><strong class="b2b-home-serif">{{ 'more.simulator.title'|trans({}, 'plugins') }}</strong><span>{{ 'more.simulator.text'|trans({}, 'plugins') }}</span></a></li>
                    {% endif %}
                </ul>
            </div>
        </section>

        {% for category, plugins in groups %}
            <section id="famille-{{ category }}" class="b2b-home-section{{ loop.index is even ? ' b2b-home-section--sand' : '' }} b2b-plugins-family" aria-labelledby="famille-{{ category }}-title" data-plugin-category="{{ category }}">
                <div class="b2b-home-wrap">
                    <div class="b2b-plugins-family__head">
                        <h2 id="famille-{{ category }}-title" class="b2b-home-h2">{{ ('families.' ~ category)|trans({}, 'plugins') }}</h2>
                        <p class="b2b-plugins-family__count">{{ 'family_count'|trans({count: plugins|length}, 'plugins') }}</p>
                    </div>
                    <ul class="b2b-plugins-grid">
                        {% for plugin in plugins %}
                            {% set version = proof.fact(plugin.slug, 'version') %}
                            {% set ci = proof.fact(plugin.slug, 'ci') %}
                            {% set compatible = proof.fact(plugin.slug, 'sylius_23') %}
                            <li class="b2b-plugins-grid__item">
                                <article class="b2b-plugins-card" id="plugin-{{ plugin.slug }}" data-plugin="{{ plugin.slug }}">
                                    <h3 class="b2b-home-serif b2b-plugins-card__name">{{ plugin.name }}</h3>
                                    <p class="b2b-plugins-card__role" data-plugin-role>{{ plugin.description(app.request.locale) }}</p>
                                    {% if version.isVerified() or ci.isVerified() or (compatible.isVerified() and compatible.value is same as(true)) %}
                                        <ul class="b2b-plugins-badges" aria-label="{{ 'badge.label'|trans({}, 'plugins') }}" data-plugin-badges>
                                            {% if version.isVerified() %}
                                                <li class="b2b-plugins-badge b2b-plugins-badge--version" data-plugin-badge="version">{{ 'badge.version'|trans({'%version%': version.value}, 'plugins') }}</li>
                                            {% endif %}
                                            {% if ci.isVerified() %}
                                                <li class="b2b-plugins-badge b2b-plugins-badge--ci-{{ ci.value == 'success' ? 'success' : (ci.value == 'failure' ? 'failure' : 'other') }}" data-plugin-badge="ci" data-plugin-ci="{{ ci.value }}">{{ ci.value in ['success', 'failure'] ? ('badge.ci.' ~ ci.value)|trans({}, 'plugins') : 'badge.ci.other'|trans({'%status%': ci.value}, 'plugins') }}</li>
                                            {% endif %}
                                            {% if compatible.isVerified() and compatible.value is same as(true) %}
                                                <li class="b2b-plugins-badge b2b-plugins-badge--sylius" data-plugin-badge="sylius">{{ 'badge.sylius'|trans({'%version%': sylius_version}, 'plugins') }}</li>
                                            {% endif %}
                                        </ul>
                                    {% endif %}
                                    <details class="b2b-plugins-details" data-plugin-details>
                                        <summary>{{ 'card.details'|trans({}, 'plugins') }}</summary>
                                        <p data-plugin-scenario><strong>{{ 'card.scenario'|trans({}, 'plugins') }}</strong> {{ plugin.scenario(app.request.locale) }}</p>
                                        <p data-plugin-account><strong>{{ 'card.account'|trans({}, 'plugins') }}</strong> <code>{{ plugin.advisedAccount }}</code></p>
                                    </details>
                                    <div class="b2b-plugins-card__links" data-plugin-links>
                                        {% set github_label %}{{ 'card.github'|trans({}, 'plugins') }}<span class="visually-hidden"> {{ plugin.name }} {{ 'cta.new_window'|trans({}, 'theme_demo') }}</span>{% endset %}
                                        {% include 'shared/_external_link.html.twig' with { url: plugin.githubUrl, label: github_label } only %}
                                        {% if plugin.packagistUrl is not null %}
                                            {% set packagist_label %}{{ 'card.packagist'|trans({}, 'plugins') }}<span class="visually-hidden"> {{ plugin.name }} {{ 'cta.new_window'|trans({}, 'theme_demo') }}</span>{% endset %}
                                            {% include 'shared/_external_link.html.twig' with { url: plugin.packagistUrl, label: packagist_label, data_attribute: 'data-plugin-packagist' } only %}
                                        {% else %}
                                            <span class="b2b-plugins-card__status" data-plugin-unpublished data-plugin-status="{{ plugin.status }}">{{ ('card.status.' ~ plugin.status)|trans({}, 'plugins') }}</span>
                                        {% endif %}
                                        {% if plugin.demoRoute is not null %}
                                            <a href="{{ path(plugin.demoRoute, {_locale: app.request.locale}) }}" data-plugin-demo-link>{{ 'card.see_in_demo'|trans({}, 'plugins') }}<span class="visually-hidden"> {{ plugin.name }}</span></a>
                                        {% else %}
                                            <span class="b2b-plugins-card__note">{{ 'card.no_demo_page'|trans({}, 'plugins') }}</span>
                                        {% endif %}
                                        {% if plugin.slug == 'sylius-b2b-mcp-plugin' %}
                                            <a href="{{ path('app_demo_mcp_guide', {_locale: app.request.locale}) }}" data-plugin-guide-link{{ app_umami_event('guide-mcp', { emplacement: 'plugins' }) }}>{{ 'card.mcp_guide'|trans({}, 'plugins') }}</a>
                                        {% endif %}
                                        {% include 'shared/_contact_cta.html.twig' with { variant: 'link', placement: 'plugin-' ~ plugin.slug, context: plugin.name } only %}
                                    </div>
                                </article>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </section>
        {% endfor %}

        <section class="b2b-home-night b2b-plugins-closing" aria-labelledby="plugins-closing-title">
            <div class="b2b-home-wrap">
                <div class="b2b-plugins-closing__body">
                    <h2 id="plugins-closing-title" class="b2b-home-h2">{{ 'closing.title'|trans({}, 'plugins') }}</h2>
                    <p>{{ 'closing.text'|trans({}, 'plugins') }}</p>
                </div>
                {% include 'shared/_contact_cta.html.twig' with { variant: 'dark', placement: 'plugins-bottom' } only %}
            </div>
        </section>

        {# US-104 (decision D2): factual sentence only, no comparison with the official offering. #}
        <div class="b2b-home-wrap">
            <p class="b2b-plugins-note" data-plugins-compat-note>{{ 'app.plugins.sylius_version'|trans }}</p>
        </div>
    </div>
{% endblock %}
