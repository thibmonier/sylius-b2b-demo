{# Packaging unit and stock under the SKU (US-198: three levels of stock). Each zone is omitted when its data is missing. #}
{% set product = hookable_metadata.context.product %}
{% set packaging = app_b2b_packaging_unit(product) %}
{% set stock = app_b2b_stock(product) %}
{% if packaging is not null or stock.level != 'untracked' %}
    <span class="b2b-meta d-flex flex-wrap gap-2 fs-7">
        {% if packaging is not null %}
            <span class="b2b-packaging" {{ sylius_test_html_attribute('b2b-product-packaging') }}><span class="visually-hidden">{{ 'app.theme_b2b.packaging'|trans }} : </span>{{ packaging }}</span>
        {% endif %}
        {% if stock.level != 'untracked' %}
            <span class="b2b-stock b2b-stock--{{ stock.level }}" data-list-stock="{{ stock.level }}" {{ sylius_test_html_attribute('b2b-product-stock') }}>
                <span class="b2b-stock__dot" aria-hidden="true"></span>
                {%- if stock.level == 'out' %}{{ 'app.theme_b2b.out_of_stock'|trans }}
                {%- elseif stock.level == 'low' %}{{ 'app.theme_b2b.stock_low'|trans({'%count%': stock.available}) }}
                {%- else %}{{ 'app.theme_b2b.in_stock'|trans }}{% endif -%}
            </span>
        {% endif %}
    </span>
{% endif %}
