{% set site_url = app_demo_site_url() %}
<div class="mt-5 border-top py-5" data-demo-footer>
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-6">
                <h2 class="h6 fw-bold">{{ 'footer.demo.title'|trans({}, 'shop_layout') }}</h2>
                <ul class="list-unstyled mb-0">
                    <li><a class="nav-link px-0 text-decoration-underline" href="{{ path('app_demo_about', {_locale: app.request.locale}) }}">{{ 'footer.demo.about'|trans({}, 'shop_layout') }}</a></li>
                    <li><a class="nav-link px-0 text-decoration-underline" href="{{ path('app_demo_plugins', {_locale: app.request.locale}) }}">{{ 'footer.demo.plugins'|trans({}, 'shop_layout') }}</a></li>
                    <li><a class="nav-link px-0 text-decoration-underline" href="{{ path('app_demo_accounts') }}">{{ 'footer.demo.journeys'|trans({}, 'shop_layout') }}</a></li>
                    <li><a class="nav-link px-0 text-decoration-underline" href="{{ path('app_demo_mcp_guide', {_locale: app.request.locale}) }}"{{ app_umami_event('guide-mcp', { emplacement: 'pied-de-page' }) }}>{{ 'footer.demo.integrate'|trans({}, 'shop_layout') }}</a></li>
                    <li><a class="nav-link px-0 text-decoration-underline" href="{{ path('app_demo_integrate', {_locale: app.request.locale}) }}">{{ 'footer.demo.integrate_project'|trans({}, 'shop_layout') }}</a></li>
                    <li><a class="nav-link px-0 text-decoration-underline" href="{{ path('app_demo_architecture', {_locale: app.request.locale}) }}">{{ 'footer.demo.architecture'|trans({}, 'shop_layout') }}</a></li>
                    <li><a class="nav-link px-0 text-decoration-underline" href="{{ path('app_demo_proof', {_locale: app.request.locale}) }}">{{ 'nav'|trans({}, 'proof') }}</a></li>
                    <li><a class="nav-link px-0 text-decoration-underline" href="{{ path('app_demo_image_credits', {_locale: app.request.locale}) }}">{{ 'footer.demo.credits'|trans({}, 'shop_layout') }}</a></li>
                    {% if app_demo_cta_targets('footer') %}
                        <li>{% include 'shared/_contact_cta.html.twig' with { variant: 'link', placement: 'footer', locale: app.request.locale } only %}</li>
                    {% endif %}
                </ul>
            </div>
            <div class="col-12 col-md-6 mt-4 mt-md-0">
                <p class="mb-2">{{ 'footer.demo.fictional'|trans({}, 'shop_layout') }}</p>
                <p class="mb-0">
                    {% if site_url %}
                        {{ 'footer.demo.made_by_prefix'|trans({}, 'shop_layout') }}
                        <a class="text-decoration-underline" href="{{ site_url }}" rel="noopener noreferrer" target="_blank" data-site-link>Thibaut Monier<span class="visually-hidden"> {{ 'external_link'|trans({}, 'shop_layout') }}</span></a>
                    {% else %}
                        {{ 'footer.demo.made_by_prefix'|trans({}, 'shop_layout') }} Thibaut Monier
                    {% endif %}
                </p>
            </div>
        </div>
    </div>
</div>
