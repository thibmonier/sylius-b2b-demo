<section class="container mb-5" data-b2b-home="quick-access">
    <h2 class="h3 mb-4 b2b-section-title">{{ 'app.home_b2b.quick_access.title'|trans }}</h2>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <div class="card h-100 b2b-tile"><div class="card-body d-flex flex-column">
                <span class="b2b-tile__icon">{{ ux_icon('tabler:users', { 'aria-hidden': 'true' }) }}</span>
                <h3 class="b2b-tile__title">{{ 'app.home_b2b.quick_access.accounts'|trans }}</h3>
                <p class="card-text flex-grow-1">{{ 'app.home_b2b.quick_access.accounts_text'|trans }}</p>
                <a class="b2b-tile__cta stretched-link" href="{{ path('app_demo_accounts') }}">{{ (app.user ? 'app.home_b2b.quick_access.accounts_link_signed_in' : 'app.home_b2b.quick_access.accounts_link')|trans }}{{ ux_icon('tabler:arrow-right', { 'aria-hidden': 'true' }) }}</a>
            </div></div>
        </div>
        {# US-019: the categories are catalogue content, hidden on a closed channel from visitors who are not signed in. #}
        {% if tmonier_channel_can_see_catalog() %}
        <div class="col">
            {# Several links: no stretched link, each category stays its own target. #}
            <div class="card h-100 b2b-tile"><div class="card-body">
                <span class="b2b-tile__icon">{{ ux_icon('tabler:building-warehouse', { 'aria-hidden': 'true' }) }}</span>
                <h3 class="b2b-tile__title">{{ 'app.home_b2b.quick_access.catalogue'|trans }}</h3>
                <ul class="list-unstyled mb-0 b2b-tile__links">
                    {% for slug in ['epi', 'quincaillerie', 'fournitures-industrielles'] %}
                        <li class="mb-1"><a class="b2b-tile__cta" href="{{ path('sylius_shop_product_index', {slug: slug, _locale: app.request.locale}) }}">{{ ux_icon('tabler:chevron-right', { 'aria-hidden': 'true' }) }}{{ ('app.home_b2b.quick_access.category.' ~ slug)|trans }}</a></li>
                    {% endfor %}
                </ul>
            </div></div>
        </div>
        {% endif %}
        <div class="col">
            <div class="card h-100 b2b-tile"><div class="card-body d-flex flex-column">
                <span class="b2b-tile__icon">{{ ux_icon('tabler:puzzle', { 'aria-hidden': 'true' }) }}</span>
                <h3 class="b2b-tile__title">{{ 'app.home_b2b.quick_access.plugins'|trans }}</h3>
                <p class="card-text flex-grow-1">{{ 'app.home_b2b.quick_access.plugins_text'|trans({'%count%': demo_plugin_count()}) }}</p>
                <a class="b2b-tile__cta stretched-link" href="{{ path('app_demo_plugins', {_locale: app.request.locale}) }}">{{ 'app.home_b2b.quick_access.plugins_link'|trans }}{{ ux_icon('tabler:arrow-right', { 'aria-hidden': 'true' }) }}</a>
            </div></div>
        </div>
    </div>
</section>
