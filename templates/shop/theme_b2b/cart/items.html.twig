{#
    US-200: the lines of the cart as cards (photo, name, reference, tier, unit price, quantity, total), replacing the core table on
    B2B. Same form fields, same live actions (removal), same test attributes as the core and the tier-pricing plugin.
#}
{% import '@SyliusShop/shared/macro/money.html.twig' as money %}
{% set form = hookable_metadata.context.form %}

<h2 id="b2b-cart-lines-title" class="visually-hidden">{{ 'lines.title'|trans({}, 'cart') }}</h2>
<div class="b2b-cart__head" aria-hidden="true">
    <span></span>
    <span>{{ 'lines.product'|trans({}, 'cart') }}</span>
    <span>{{ 'lines.unit_price'|trans({}, 'cart') }}</span>
    <span>{{ 'lines.quantity'|trans({}, 'cart') }}</span>
    <span class="text-end">{{ 'lines.total'|trans({}, 'cart') }}</span>
</div>
<ul class="b2b-cart__lines" {{ sylius_test_html_attribute('cart-items') }}>
    {% for index, form_item in form.items %}
        {% set item = form_item.vars.data %}
        {% set variant = item.variant %}
        {% set product = variant.product %}
        {% set discount = app_b2b_cart_line_discount(item) %}
        {% set tier = tmonier_tier_pricing_item_tier(item) %}
        {% set table = tmonier_tier_pricing_cart_table(item) %}
        <li class="b2b-cart__line" {{ sylius_test_html_attribute('cart-item', index) }} {{ sylius_test_html_attribute('cart-item-product-row', item.productName) }} {{ sylius_test_html_attribute('b2b-cart-line') }}>
            <a class="b2b-cart__photo" href="{{ path('sylius_shop_product_show', {'slug': product.slug, '_locale': product.translation.locale}) }}" tabindex="-1" aria-hidden="true">
                {{ component('sylius_shop:main_image', {
                    product: variant.hasImages ? variant : product,
                    class: 'b2b-cart__photo-image',
                    filter: 'sylius_shop_product_thumbnail'
                }) }}
            </a>
            <div class="b2b-cart__product" {{ sylius_test_html_attribute('cart-item-product') }}>
                <a class="b2b-cart__name" href="{{ path('sylius_shop_product_show', {'slug': product.slug, '_locale': product.translation.locale}) }}" {{ sylius_test_html_attribute('product-name', item.productName) }}>{{ item.productName }}</a>
                <span class="b2b-cart__reference" {{ sylius_test_html_attribute('product-variant-code', variant.code) }}>{{ 'lines.reference'|trans({'%sku%': variant.code}, 'cart') }}</span>
                {% if item.variantName is not null and item.variantName != item.productName %}<span class="b2b-cart__variant" {{ sylius_test_html_attribute('product-variant-name') }}>{{ item.variantName }}</span>{% endif %}
                {% if discount is not null and tier is not null %}
                    {% set percent = app_b2b_percent(discount.percent, app.request.locale) %}
                    <span class="b2b-cart__tier" {{ sylius_test_html_attribute('b2b-cart-tier') }} {{ sylius_test_html_attribute('tmonier-tier-applied') }}>
                        {%- if discount.negotiated -%}
                            <span {{ sylius_test_html_attribute('b2b-negotiated-applied') }}>{{ 'lines.negotiated'|trans({'%company%': item.order.customer.group.name|default(''), '%quantity%': tier.minQuantity|default(''), '%percent%': percent}, 'cart') }}</span>
                        {%- else -%}
                            {{ 'lines.tier'|trans({'%quantity%': tier.minQuantity|default(''), '%percent%': percent}, 'cart') }}
                        {%- endif -%}
                    </span>
                {% endif %}
                {% if table is not null and table.nudge is not null %}
                    {% set tax_convention = tmonier_tier_pricing_tax_convention(item.variant) %}
                    {% set tax_suffix = tax_convention is null ? '' : ' ' ~ ((tax_convention == 'included' ? 'tmonier_tier_pricing.ui.incl_tax' : 'tmonier_tier_pricing.ui.excl_tax')|trans) %}
                    <span class="b2b-cart__nudge" {{ sylius_test_html_attribute('tmonier-tier-nudge') }}>
                        {{ 'tmonier_tier_pricing.ui.nudge'|trans({'%quantity%': table.nudge.quantityToAdd, '%price%': money.convertAndFormat(table.nudge.unitPrice) ~ tax_suffix}) }}
                    </span>
                {% endif %}
                <button
                    class="b2b-cart__remove"
                    type="button"
                    data-action="live#action:prevent"
                    data-live-action-param="removeItem"
                    data-live-index-param="{{ index }}"
                    aria-label="{{ 'lines.remove_label'|trans({'%name%': item.productName}, 'cart') }}"
                    {{ sylius_test_html_attribute('remove-cart-item') }}
                >{{ 'lines.remove'|trans({}, 'cart') }}</button>
            </div>
            <div class="b2b-cart__unit">
                <span class="visually-hidden">{{ 'lines.unit_price'|trans({}, 'cart') }} : </span>
                <span class="b2b-cart__price" {{ sylius_test_html_attribute('cart-item-unit-price') }}>{{ money.convertAndFormat(item.discountedUnitPrice) }}</span>
                {% if discount is not null %}
                    <span class="b2b-cart__catalogue"><s {{ sylius_test_html_attribute('cart-item-unit-regular-price') }}>{{ money.convertAndFormat(discount.catalogueUnitPrice) }}</s> {{ 'lines.catalogue_price'|trans({}, 'cart') }}</span>
                {% endif %}
            </div>
            <div class="b2b-cart__quantity" data-controller="b2b-cart-quantity">
                <button type="button" class="b2b-cart__step" data-action="b2b-cart-quantity#decrease" aria-label="{{ 'lines.decrease_label'|trans({'%name%': item.productName}, 'cart') }}">−</button>
                {% set quantity_attributes = {'class': 'b2b-cart__quantity-input', 'aria-label': 'lines.quantity_label'|trans({'%name%': item.productName}, 'cart'), 'data-b2b-cart-quantity-target': 'input'} %}
                {{ form_widget(form_item.quantity, sylius_test_form_attribute('cart-item-quantity')|sylius_merge_recursive({attr: quantity_attributes})) }}
                <button type="button" class="b2b-cart__step" data-action="b2b-cart-quantity#increase" aria-label="{{ 'lines.increase_label'|trans({'%name%': item.productName}, 'cart') }}">+</button>
            </div>
            <div class="b2b-cart__line-total">
                <span class="visually-hidden">{{ 'lines.total'|trans({}, 'cart') }} : </span>
                <span class="b2b-cart__amount" {{ sylius_test_html_attribute('cart-product-subtotal') }}>{{ money.convertAndFormat(item.subtotal) }}</span>
                {% if discount is not null %}
                    <span class="b2b-cart__saving" {{ sylius_test_html_attribute('b2b-cart-line-discount') }}>{{ 'lines.saving'|trans({'%amount%': money.convertAndFormat(discount.amount)}, 'cart') }}</span>
                {% endif %}
            </div>
        </li>
    {% endfor %}
</ul>
