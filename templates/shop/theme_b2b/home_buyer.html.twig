{#
    US-089: the three product blocks of the signed-in B2B home page, in place of the two core blocks ("latest deals" and
    "latest products", the same articles twice). A product appears in one block only (HomeSelectionProvider).
#}
{% set selection = app_b2b_home_selection() %}
{% macro cards(products, hookable_metadata) %}
    <div class="products-grid">
        {% for product in products %}
            <div>{{ component('sylius_shop:product:card', { product: product, template: '@SyliusShop/product/common/card.html.twig', hookableMetadata: hookable_metadata }) }}</div>
        {% endfor %}
    </div>
{% endmacro %}

{% if selection.usual is not empty %}
    <section class="container mb-5" data-b2b-home="usual" aria-labelledby="b2b-home-usual">
        <h2 class="h3 mb-2 b2b-section-title" id="b2b-home-usual">{{ (selection.usualFromHistory ? 'app.home_b2b.buyer.usual.title' : 'app.home_b2b.buyer.usual.title_start')|trans }}</h2>
        <p class="mb-4 text-secondary">{{ (selection.usualFromHistory ? 'app.home_b2b.buyer.usual.intro' : 'app.home_b2b.buyer.usual.intro_start')|trans }}</p>
        {{ _self.cards(selection.usual, hookable_metadata) }}
    </section>
{% endif %}

{% if selection.restock is not empty %}
    <section class="container mb-5" data-b2b-home="restock" aria-labelledby="b2b-home-restock">
        <h2 class="h3 mb-2 b2b-section-title" id="b2b-home-restock">{{ 'app.home_b2b.buyer.restock.title'|trans }}</h2>
        <p class="mb-4 text-secondary">{{ (selection.restockFromList ? 'app.home_b2b.buyer.restock.intro' : 'app.home_b2b.buyer.restock.intro_start')|trans }}
            {% if selection.restockFromList %}<a href="{{ path('app_shop_company_wishlist_index', {_locale: app.request.locale}) }}">{{ 'app.home_b2b.buyer.restock.link'|trans }}</a>{% endif %}
        </p>
        {{ _self.cards(selection.restock, hookable_metadata) }}
    </section>
{% endif %}

{% if selection.negotiated is not empty %}
    <section class="container mb-5" data-b2b-home="negotiated" aria-labelledby="b2b-home-negotiated">
        <h2 class="h3 mb-2 b2b-section-title" id="b2b-home-negotiated">{{ 'app.home_b2b.buyer.negotiated.title'|trans }}</h2>
        <p class="mb-4 text-secondary">{{ 'app.home_b2b.buyer.negotiated.intro'|trans }}</p>
        {{ _self.cards(selection.negotiated, hookable_metadata) }}
    </section>
{% endif %}
