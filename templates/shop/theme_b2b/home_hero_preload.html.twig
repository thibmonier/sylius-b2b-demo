{# US-186: the hero photo is the largest element of the first view: fetched as soon as the head is read (same srcset and sizes as the image). #}
{% set photo = demo_home_photo('hero') %}
{% set base = 'build/app/shop/images/home/' %}
<link rel="preload" as="image" type="image/webp" fetchpriority="high" imagesrcset="{% for file in photo.files %}{{ asset(base ~ file.file, 'app.shop') }} {{ file.width }}w{{ loop.last ? '' : ', ' }}{% endfor %}" imagesizes="(min-width: 1100px) 38rem, (min-width: 992px) 45vw, calc(100vw - 2.5rem)">
