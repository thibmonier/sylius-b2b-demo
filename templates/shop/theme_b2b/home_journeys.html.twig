{# The icons are bundled in assets/icons/tabler/ (bin/console ux:icons:import): no runtime download. #}
{% set journeys = {
    quote: { route: 'tmonier_quote_request_shop_new', icon: 'tabler:file-invoice' },
    quick_order: { route: 'tmonier_quick_order_shop_index', icon: 'tabler:bolt' },
    approval: { route: 'tmonier_purchase_approval_shop_approvals', icon: 'tabler:circle-check' },
    punchout: { route: 'tmonier_punchout_inspect', icon: 'tabler:plug-connected' },
} %}
<section class="container mb-5" data-b2b-home="journeys">
    <h2 class="h3 mb-4 b2b-section-title">{{ 'app.home_b2b.journeys.title'|trans }}</h2>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        {% for journey, item in journeys %}
            <div class="col">
                <div class="card h-100 b2b-tile"><div class="card-body d-flex flex-column">
                    <span class="b2b-tile__icon">{{ ux_icon(item.icon, { 'aria-hidden': 'true' }) }}</span>
                    <h3 class="b2b-tile__title">{{ ('app.home_b2b.journeys.' ~ journey ~ '.title')|trans }}</h3>
                    <p class="card-text flex-grow-1">{{ ('app.home_b2b.journeys.' ~ journey ~ '.text')|trans }}</p>
                    <a class="b2b-tile__cta stretched-link" href="{{ path(item.route, {_locale: app.request.locale}) }}" data-b2b-journey="{{ journey }}">{{ 'app.home_b2b.journeys.try'|trans }}{{ ux_icon('tabler:arrow-right', { 'aria-hidden': 'true' }) }}</a>
                </div></div>
            </div>
        {% endfor %}
    </div>
</section>
