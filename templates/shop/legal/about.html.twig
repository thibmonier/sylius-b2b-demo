{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'about.title'|trans({}, 'legal') }}{% endblock %}

{% block content %}
    <div class="container my-5" data-legal-page="about">
        <h1>{{ 'about.title'|trans({}, 'legal') }}</h1>
        <p class="lead">{{ 'about.intro'|trans({}, 'legal') }}</p>

        <h2>{{ 'about.fictional'|trans({}, 'legal') }}</h2>
        <ul>
            <li>{{ 'about.fictional_data'|trans({}, 'legal') }}</li>
            <li>{{ 'about.fictional_reset'|trans({}, 'legal') }}</li>
            <li>{{ 'about.fictional_mail'|trans({}, 'legal') }}</li>
        </ul>

        <h2>{{ 'about.plugins'|trans({}, 'legal') }}</h2>
        <p>{{ 'about.plugins_intro'|trans({'%count%': demo_plugin_count()}, 'legal') }}</p>
        <ul data-plugin-list>
            {% for plugin in plugins %}
                <li>{% include 'shared/_external_link.html.twig' with { url: plugin.githubUrl, label: plugin.slug } only %}</li>
            {% endfor %}
        </ul>
        <p><a href="{{ path('app_demo_plugins', {_locale: app.request.locale}) }}">{{ 'app.plugins.title'|trans }}</a></p>

        {% include 'shared/_contact_cta.html.twig' with { variant: 'card', placement: 'about' } only %}

        <h2>{{ 'about.credits'|trans({}, 'legal') }}</h2>
        <p>{{ 'about.credits_text'|trans({}, 'legal') }}</p>
        <p>{{ 'about.trademarks'|trans({}, 'legal') }}</p>
    </div>
{% endblock %}
