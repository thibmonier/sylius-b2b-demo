{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'app.company_wishlist.menu'|trans({}, 'wishlist') }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container my-5" data-test-company-wishlists>
        <h1 class="h2">{{ 'app.company_wishlist.title'|trans({'%company%': company.name}, 'wishlist') }}</h1>
        <p class="text-muted">{{ 'app.company_wishlist.intro'|trans({}, 'wishlist') }}</p>

        {% if lists is empty %}
            <div class="alert alert-info">{{ 'app.company_wishlist.empty'|trans({}, 'wishlist') }}</div>
        {% else %}
            <div class="list-group">
                {% for list in lists %}
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="{{ path('app_shop_company_wishlist_show', {id: list.id}) }}" data-test-company-wishlist-link>
                        <span>
                            <strong>{{ list.name }}</strong>
                            {% if list.createdBy %}<small class="text-muted ms-2">{{ 'app.company_wishlist.created_by'|trans({'%name%': list.createdBy.fullName}, 'wishlist') }}</small>{% endif %}
                        </span>
                        <span class="badge bg-secondary">{{ 'app.company_wishlist.items_count'|trans({'%count%': list.wishlist.wishlistProducts|length}, 'wishlist') }}</span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
