{# US-078: copy of the Sylius template. The main image is the 800 px file (with a 400 and a 1200 px choice in srcset), not the 1200 x 1600 one every phone used to download; the full-size original stays behind the link. #}
{# US-197: the files are 4:3 (800 x 600), the frame of the product page is 4:3: nothing is cut here, the point focal (object-position) only matters when the frame narrows. #}
{% set product = hookable_metadata.context.product %}
{% set srcset = null %}

{% if product.images.first %}
    {% set source_path = product.images.first.path %}
    {% set original_path = source_path|imagine_filter('sylius_shop_product_original') %}
    {% set path = source_path|imagine_filter(filter|default('b2b_photo')) %}
    {% set srcset = source_path|imagine_filter('b2b_photo_small') ~ ' 400w, ' ~ path ~ ' 800w, ' ~ source_path|imagine_filter('b2b_photo_large') ~ ' 1200w' %}
{% else %}
    {% set original_path = asset('bundles/syliusui/images/400x300.png') %}
    {% set path = original_path %}
{% endif %}

<div class="row spotlight-group mb-5" {{ stimulus_controller('product-show-images') }}>
    <div data-product-image="{{ path }}" data-product-link="{{ original_path }}"></div>
    {% hook 'images' with { original_path, path, srcset } %}
</div>
