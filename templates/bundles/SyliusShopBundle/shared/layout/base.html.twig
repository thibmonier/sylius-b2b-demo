{# US-072: copy of the Sylius shop layout with the page landmarks (header, main, footer) and the skip link added. US-078: with the description and share metadata. #}
{% import "@SyliusUi/macro/rtl.html.twig" as rtl %}

{% set generic_hook = 'sylius_shop.base' %}
{% set prefixes = prefixes|default([])|merge([generic_hook]) %}

<!DOCTYPE html>

<html lang="{{ app.request.locale|slice(0, 2) }}" {{ rtl.default(sylius.localeCode) }}>
    <head>
        {% block metatags %}
            {% hook '#metatags' with { _prefixes: prefixes } %}
        {% endblock %}

        {# US-207: an indexable page carries a title written for the search (translation `title.<route>` of the `seo` domain), the others keep the one of their template. #}
        {% set seo_page_title = app_seo_title(app.request.attributes.get('_route')) %}
        <title>{% if seo_page_title %}{{ seo_page_title }}{% else %}{% block title %}{{ sylius.channel.name }}{% endblock %}{% endif %}</title>
        {# US-078: description, canonical and share metadata #}
        {% include 'shop/seo/metatags.html.twig' with { seo_title: app_seo_plain_text(seo_page_title ?? block('title')) } %}

        {% block stylesheets %}
            {% hook '#stylesheets' with { _prefixes: prefixes } %}
        {% endblock %}

        {% hook 'head' with { _prefixes: prefixes } %}

        {# US-143: audience measurement, only when configured #}
        {% include 'shared/_umami.html.twig' %}
    </head>

    <body data-route="{{ app.request.attributes.get('_route') }}">
        {% block body %}
            <div class="{% apply escape %}{% hook '#body_classes' with { _prefixes: prefixes } %}{% endapply %}">
                <a href="#main-content" class="visually-hidden-focusable position-fixed top-0 start-0 m-2 px-3 py-2 bg-white text-dark border border-dark rounded" style="z-index: 2000" data-skip-link>{{ 'skip_link'|trans({}, 'shop_layout') }}</a>

                {% block header %}
                    <header>
                        {% hook 'header' with { _prefixes: prefixes } %}
                    </header>
                {% endblock %}

                <main id="main-content" tabindex="-1">
                    {% block content %}{% endblock %}
                </main>

                {% block footer %}
                    <footer class="mt-auto">
                        {% hook 'footer' with { _prefixes: prefixes } %}
                    </footer>
                {% endblock %}
            </div>
            {% hook 'offcanvas' with { _prefixes: prefixes } %}
        {% endblock %}

        {% block javascripts %}
            {% hook '#javascripts' with { _prefixes: prefixes } %}
        {% endblock %}
    </body>
</html>
