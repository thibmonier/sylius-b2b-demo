{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% set account = 'claire@acme.example' %}

{% block title %}{{ 'title'|trans({}, 'mcp_guide') }}{% endblock %}

{% block content %}
    <div class="container my-5" data-page="mcp-guide">
        <h1>{{ 'title'|trans({}, 'mcp_guide') }}</h1>
        <p class="lead">{{ 'intro'|trans({}, 'mcp_guide') }}</p>

        {% if private_demo %}
            <div class="alert alert-warning" role="note" data-mcp-private-note>{{ 'private_note'|trans({}, 'mcp_guide') }}</div>
        {% endif %}

        <p>{{ 'server'|trans({}, 'mcp_guide') }} <code data-mcp-server-url>{{ server_url }}</code></p>

        {% if transcript %}
            <section class="mt-4" data-mcp-transcript aria-labelledby="mcp-transcript-title">
                <h2 class="h4" id="mcp-transcript-title">{{ 'transcript.title'|trans({}, 'mcp_guide') }}</h2>
                <p>{{ 'transcript.intro'|trans({'%assistant%': transcript.assistant}, 'mcp_guide') }} {{ 'transcript.recorded'|trans({}, 'mcp_guide') }} <time datetime="{{ transcript.recordedAt }}">{{ transcript.recordedAt }}</time>.</p>
                <p data-mcp-transcript-no-payment>{{ 'transcript.no_payment'|trans({}, 'mcp_guide') }}</p>
                <ol class="list-unstyled d-grid gap-3">
                    {% for exchange in transcript.exchanges %}
                        <li class="border rounded p-3" data-mcp-exchange="{{ loop.index }}">
                            <p class="mb-1 fw-bold">{{ 'transcript.buyer'|trans({}, 'mcp_guide') }}</p>
                            <p class="mb-2" lang="{{ transcript.locale }}" style="white-space: pre-line; overflow-wrap: anywhere;">{{ exchange.user }}</p>
                            {% if exchange.tools %}
                                <p class="small mb-2" data-mcp-tools>{{ 'transcript.tools'|trans({}, 'mcp_guide') }} {% for tool in exchange.tools %}<code>{{ tool }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</p>
                            {% endif %}
                            <p class="mb-1 fw-bold">{{ transcript.assistant }}</p>
                            <p class="mb-0" lang="{{ transcript.locale }}" style="white-space: pre-line; overflow-wrap: anywhere;">{{ exchange.assistant }}</p>
                        </li>
                    {% endfor %}
                </ol>
                {% if transcript.media %}
                    <figure class="mt-3" data-mcp-transcript-media="{{ transcript.media.kind }}">
                        {% if transcript.media.kind == 'video' %}
                            <video controls preload="none" playsinline class="w-100"{% if transcript.media.poster %} poster="{{ transcript.media.poster }}"{% endif %}>
                                <source src="{{ transcript.media.src }}">
                                <a href="{{ transcript.media.src }}">{{ 'transcript.download'|trans({}, 'mcp_guide') }}</a>
                            </video>
                        {% else %}
                            <img src="{{ transcript.media.poster }}" alt="{{ transcript.media.description }}" class="img-fluid" data-mcp-gif data-animation="{{ transcript.media.src }}" data-still="{{ transcript.media.poster }}">
                            <button type="button" class="btn btn-outline-secondary mt-2" style="min-height: 44px; min-width: 44px;" data-mcp-gif-toggle aria-pressed="false" data-play="{{ 'transcript.play'|trans({}, 'mcp_guide') }}" data-pause="{{ 'transcript.pause'|trans({}, 'mcp_guide') }}">{{ 'transcript.play'|trans({}, 'mcp_guide') }}</button>
                        {% endif %}
                        <figcaption class="small mt-2">{{ transcript.media.description }} {{ 'transcript.alternative'|trans({}, 'mcp_guide') }}</figcaption>
                    </figure>
                {% endif %}
            </section>
        {% endif %}

        <ol class="mt-4 d-grid gap-3">
            {% for step in 1..6 %}
                <li data-mcp-step="{{ step }}">
                    <strong>{{ ('step.' ~ step ~ '.title')|trans({}, 'mcp_guide') }}</strong>
                    <div>{{ ('step.' ~ step ~ '.text')|trans({'%account%': account, '%url%': server_url}, 'mcp_guide') }}</div>
                </li>
            {% endfor %}
        </ol>

        <h2 class="h4 mt-5">{{ 'config.title'|trans({}, 'mcp_guide') }}</h2>
        <p>{{ 'config.text'|trans({}, 'mcp_guide') }}</p>
        <pre class="border rounded p-3 bg-light"><code id="mcp-config" data-mcp-config>{{ {
            mcpServers: { 'fournitures-pro-demo': { command: 'npx', args: ['-y', 'mcp-remote', server_url] } },
        }|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) }}</code></pre>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-mcp-copy="#mcp-config">{{ 'config.copy'|trans({}, 'mcp_guide') }}</button>

        <h2 class="h4 mt-5">{{ 'limits.title'|trans({}, 'mcp_guide') }}</h2>
        <ul>
            <li data-mcp-unapproved>{{ 'limits.unapproved'|trans({}, 'mcp_guide') }}</li>
            <li data-mcp-reconnect>{{ 'limits.reconnect'|trans({}, 'mcp_guide') }}</li>
            <li>{{ 'limits.outbound'|trans({}, 'mcp_guide') }}</li>
            <li>{{ 'limits.reset'|trans({}, 'mcp_guide') }}</li>
            <li>{{ 'limits.no_payment'|trans({}, 'mcp_guide') }}</li>
        </ul>

        <h2 class="h4 mt-5">{{ 'links.title'|trans({}, 'mcp_guide') }}</h2>
        <ul data-mcp-links>
            <li><a href="{{ path('app_demo_accounts') }}">{{ 'links.accounts'|trans({}, 'mcp_guide') }}</a></li>
            <li><a href="{{ path('tmonier_b2b_mcp_shop_connections', {_locale: app.request.locale}) }}">{{ 'links.connections'|trans({}, 'mcp_guide') }}</a></li>
            <li><a href="{{ path('tmonier_b2b_mcp_oauth_authorization_server') }}">{{ 'links.metadata'|trans({}, 'mcp_guide') }}</a></li>
            <li><a href="{{ path('app_demo_plugins', {_locale: app.request.locale}) }}">{{ 'links.plugins'|trans({}, 'mcp_guide') }}</a></li>
            <li>{% include 'shared/_external_link.html.twig' with { url: 'https://github.com/thibmonier/sylius-b2b-mcp-plugin', label: 'links.plugin'|trans({}, 'mcp_guide') } only %}</li>
            <li>{% include 'shared/_external_link.html.twig' with { url: 'https://support.claude.com/en/articles/11503834', label: 'links.claude'|trans({}, 'mcp_guide') } only %}</li>
        </ul>
        {% include 'shared/_contact_cta.html.twig' with { variant: 'card', placement: 'mcp' } only %}
    </div>

    <script>
        document.querySelectorAll('[data-mcp-gif-toggle]').forEach(function (button) {
            var image = document.querySelector('[data-mcp-gif]');
            if (!image) {
                return;
            }
            button.addEventListener('click', function () {
                var playing = button.getAttribute('aria-pressed') === 'true';
                image.src = playing ? image.dataset.still : image.dataset.animation;
                button.setAttribute('aria-pressed', playing ? 'false' : 'true');
                button.textContent = playing ? button.dataset.play : button.dataset.pause;
            });
        });
        document.querySelectorAll('[data-mcp-copy]').forEach(function (button) {
            button.addEventListener('click', function () {
                var source = document.querySelector(button.dataset.mcpCopy);
                if (source && navigator.clipboard) {
                    navigator.clipboard.writeText(source.textContent.trim());
                }
            });
        });
    </script>
{% endblock %}
