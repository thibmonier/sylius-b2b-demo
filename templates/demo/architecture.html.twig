{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'title'|trans({}, 'architecture') }}{% endblock %}

{#
    US-170: how the demo itself is built. US-206: in the editorial look of the B2B home (validated mock-up of 2026-10-28):
    introduction, table of contents, six numbered sections with one visual each; the overview diagram is HTML/CSS and
    stacks on a phone. The page serves both channels: the classes of the B2B stylesheet only style the B2B one, the markup
    stays readable on the other (numbers are CSS counters). No figure is written here: they come from proof.json (report)
    or the configuration (versions); the security section stays general (no route, value nor threshold). Links point to
    the public repository.
#}
{% set repository = 'https://github.com/thibmonier/sylius-b2b-demo/' %}
{% set tests = report.deliveryFact('tests') %}
{% set phpstan = report.deliveryFact('phpstan') %}
{% set ci = report.deliveryFact('ci') %}
{% set unavailable = 'figures.unavailable'|trans({}, 'architecture') %}

{% macro links(items, repository) %}
    <ul class="b2b-architecture-links" data-architecture-links>
        {% for path, label in items %}
            <li>{% include 'shared/_external_link.html.twig' with { url: repository ~ path, label: label|trans({}, 'architecture') } only %}</li>
        {% endfor %}
    </ul>
{% endmacro %}

{% block content %}
    {% import _self as page %}
    {% set sections = ['overview', 'layers', 'flows', 'operations', 'quality', 'security', 'mockups'] %}
    <div class="b2b-architecture" data-page="architecture">
        <section class="b2b-home-section b2b-architecture-intro" aria-labelledby="architecture-title">
            <div class="b2b-home-wrap">
                <p class="b2b-home-eyebrow">{{ 'eyebrow'|trans({}, 'architecture') }}</p>
                <h1 id="architecture-title" class="b2b-home-h1">{{ 'title_start'|trans({}, 'architecture') }} <span class="b2b-home-h1__accent">{{ 'title_accent'|trans({}, 'architecture') }}</span></h1>
                <p class="b2b-home-lead">{{ 'intro'|trans({}, 'architecture') }}</p>
                <nav aria-label="{{ 'toc.label'|trans({}, 'architecture') }}" data-architecture-toc>
                    <ul class="b2b-architecture-toc">
                        {% for section in sections %}
                            <li><a class="b2b-architecture-chip" href="#architecture-{{ section }}">{{ (section ~ '.title')|trans({}, 'architecture') }}</a></li>
                        {% endfor %}
                    </ul>
                </nav>
            </div>
        </section>

        <div class="b2b-home-wrap b2b-architecture-body">
            <section class="b2b-architecture-section" data-architecture-section="overview" aria-labelledby="architecture-overview">
                <div class="b2b-architecture-section__head"><h2 class="b2b-home-h2" id="architecture-overview" tabindex="-1">{{ 'overview.title'|trans({}, 'architecture') }}</h2></div>
                <ul class="b2b-architecture-tiles">
                    <li class="b2b-architecture-tile"><span class="b2b-architecture-tile__value" data-architecture-figure="plugins">{{ versions['%plugins%'] }}</span><span class="b2b-architecture-tile__label">{{ 'figures.plugins'|trans({}, 'architecture') }}</span></li>
                    <li class="b2b-architecture-tile"><span class="b2b-architecture-tile__value" data-architecture-figure="tests">{{ tests.isVerified() ? tests.value : unavailable }}</span><span class="b2b-architecture-tile__label">{{ 'figures.tests'|trans({}, 'architecture') }}</span></li>
                    <li class="b2b-architecture-tile"><span class="b2b-architecture-tile__value" data-architecture-figure="sylius">{{ versions['%sylius%'] }}</span><span class="b2b-architecture-tile__label">{{ 'figures.sylius'|trans({}, 'architecture') }}</span></li>
                    <li class="b2b-architecture-tile"><span class="b2b-architecture-tile__value" data-architecture-figure="symfony">{{ versions['%symfony%'] }}</span><span class="b2b-architecture-tile__label">{{ 'figures.symfony'|trans({}, 'architecture') }}</span></li>
                </ul>
                {# US-206: HTML/CSS diagram (replaces the SVG); the sentence below is its textual equivalent, the arrows are decoration. #}
                <figure class="b2b-architecture-diagram" data-architecture-overview data-architecture-visual aria-labelledby="architecture-figure-caption" aria-describedby="architecture-figure-desc">
                    <p id="architecture-figure-desc" class="visually-hidden">{{ 'overview.figure_desc'|trans(versions, 'architecture') }}</p>
                    <div class="b2b-architecture-diagram__frame">
                        <ul class="b2b-architecture-row" data-architecture-entries>
                            <li class="b2b-architecture-box">{{ 'overview.browser'|trans({}, 'architecture') }}</li>
                            <li class="b2b-architecture-box">{{ 'overview.assistant'|trans({}, 'architecture') }}</li>
                            <li class="b2b-architecture-box">{{ 'overview.procurement'|trans({}, 'architecture') }}</li>
                        </ul>
                        <div class="b2b-architecture-arrows" aria-hidden="true"><span>↓</span><span>↓</span><span>↓</span></div>
                        <div class="b2b-architecture-container" data-architecture-container>
                            <p class="b2b-architecture-container__title">{{ 'overview.container'|trans({}, 'architecture') }}</p>
                            <div class="b2b-architecture-container__columns">
                                <ul>
                                    <li class="b2b-architecture-box b2b-architecture-box--inner">{{ 'overview.sylius'|trans(versions, 'architecture') }}</li>
                                    <li class="b2b-architecture-box b2b-architecture-box--inner">{{ 'overview.plugins'|trans(versions, 'architecture') }}</li>
                                    <li class="b2b-architecture-box b2b-architecture-box--inner">{{ 'overview.demo_layer'|trans({}, 'architecture') }}</li>
                                </ul>
                                <ul>
                                    <li class="b2b-architecture-box b2b-architecture-box--inner">{{ 'overview.scheduler'|trans({}, 'architecture') }}</li>
                                    <li class="b2b-architecture-box b2b-architecture-box--inner b2b-architecture-box--wide">{{ 'overview.flows'|trans({}, 'architecture') }}</li>
                                </ul>
                            </div>
                        </div>
                        <div class="b2b-architecture-arrows" aria-hidden="true"><span>↕</span><span>↕</span><span>↑</span></div>
                        <ul class="b2b-architecture-row" data-architecture-storage>
                            <li class="b2b-architecture-box">{{ 'overview.database'|trans({}, 'architecture') }}</li>
                            <li class="b2b-architecture-box">{{ 'overview.media'|trans({}, 'architecture') }}</li>
                            <li class="b2b-architecture-box">{{ 'overview.delivery'|trans({}, 'architecture') }}</li>
                        </ul>
                    </div>
                    <figcaption id="architecture-figure-caption" class="b2b-architecture-caption">{{ 'overview.caption'|trans({}, 'architecture') }}</figcaption>
                </figure>
                {{ page.links({'blob/main/docker/Dockerfile': 'links.dockerfile', 'blob/main/docker/Caddyfile': 'links.caddyfile', 'blob/main/docs/adr/0002-frankenphp-et-supercronic-dans-un-seul-conteneur.md': 'links.adr_container'}, repository) }}
            </section>

            <section class="b2b-architecture-section" data-architecture-section="layers" aria-labelledby="architecture-layers">
                <div class="b2b-architecture-section__head"><h2 class="b2b-home-h2" id="architecture-layers" tabindex="-1">{{ 'layers.title'|trans({}, 'architecture') }}</h2></div>
                <ol class="b2b-architecture-layers" aria-label="{{ 'labels.layers'|trans({}, 'architecture') }}" data-architecture-visual>
                    {% for layer in ['core', 'plugins', 'demo', 'theme'] %}
                        <li class="b2b-architecture-layer" style="--architecture-depth: {{ loop.index0 }}" data-architecture-layer>
                            <h3>{{ ('layers.' ~ layer ~ '.name')|trans(versions, 'architecture') }}</h3>
                            <p>{{ ('layers.' ~ layer ~ '.text')|trans(versions, 'architecture') }}</p>
                        </li>
                    {% endfor %}
                </ol>
                <p class="b2b-architecture-inline"><a href="{{ path('app_demo_packs', {_locale: app.request.locale}) }}" data-architecture-packs-link>{{ 'layers.packs_link'|trans({}, 'architecture') }}</a></p>
                {{ page.links({'blob/main/composer.json': 'links.composer', 'tree/main/src/Demo': 'links.demo_layer', 'blob/main/docs/vitrine-plugins.md': 'links.showcase', 'blob/main/docs/adr/0004-theme-par-ajouts-de-twig-hooks.md': 'links.adr_theme'}, repository) }}
            </section>

            <section class="b2b-architecture-section" data-architecture-section="flows" aria-labelledby="architecture-flows">
                <div class="b2b-architecture-section__head"><h2 class="b2b-home-h2" id="architecture-flows" tabindex="-1">{{ 'flows.title'|trans({}, 'architecture') }}</h2></div>
                <ul class="b2b-architecture-cards b2b-architecture-cards--three">
                    {% for flow in ['events', 'webhooks', 'mcp', 'punchout', 'invoice'] %}
                        <li class="b2b-architecture-card" data-architecture-flow>
                            <h3>{{ ('flows.' ~ flow ~ '.name')|trans({}, 'architecture') }}</h3>
                            <p>{{ ('flows.' ~ flow ~ '.text')|trans({}, 'architecture') }}</p>
                        </li>
                    {% endfor %}
                </ul>
                <h3 class="b2b-architecture-subtitle" id="architecture-example">{{ 'flows.example.title'|trans({}, 'architecture') }}</h3>
                <ol class="b2b-architecture-steps" aria-labelledby="architecture-example" data-architecture-visual>
                    {% for step in ['arrival', 'order', 'outbox', 'delivery', 'invoice', 'assistant'] %}
                        <li class="b2b-architecture-step" data-architecture-step><span>{{ ('flows.example.' ~ step)|trans({}, 'architecture') }}</span></li>
                    {% endfor %}
                </ol>
                {{ page.links({'blob/main/docs/webhooks-demo.md': 'links.webhooks', 'blob/main/docs/mcp.md': 'links.mcp', 'tree/main/src/Demo/PunchOutSimulator': 'links.punchout', 'blob/main/docker/crontab': 'links.crontab'}, repository) }}
            </section>

            <section class="b2b-architecture-section" data-architecture-section="operations" aria-labelledby="architecture-operations">
                <div class="b2b-architecture-section__head"><h2 class="b2b-home-h2" id="architecture-operations" tabindex="-1">{{ 'operations.title'|trans({}, 'architecture') }}</h2></div>
                <ul class="b2b-architecture-cards" data-architecture-visual>
                    {% for item in ['image', 'deployment', 'reset', 'public'] %}
                        <li class="b2b-architecture-card" data-architecture-operation>
                            <h3>{{ ('operations.' ~ item ~ '.name')|trans({}, 'architecture') }}</h3>
                            <p>{{ ('operations.' ~ item ~ '.text')|trans({}, 'architecture') }}</p>
                        </li>
                    {% endfor %}
                </ul>
                {{ page.links({'blob/main/.github/workflows/ci.yaml': 'links.ci', 'blob/main/docs/deploiement-railway.md': 'links.railway', 'blob/main/docs/remise-a-zero-demo.md': 'links.reset', 'blob/main/docs/ouverture-publique.md': 'links.public'}, repository) }}
            </section>

            <section class="b2b-architecture-section" data-architecture-section="quality" aria-labelledby="architecture-quality">
                <div class="b2b-architecture-section__head"><h2 class="b2b-home-h2" id="architecture-quality" tabindex="-1">{{ 'quality.title'|trans({}, 'architecture') }}</h2></div>
                {% set show_ci = ci.isVerified() and ci.source starts with repository %}
                <ul class="b2b-architecture-tiles{{ show_ci ? ' b2b-architecture-tiles--three' : '' }}" data-architecture-visual>
                    <li class="b2b-architecture-tile" data-architecture-quality-tile>
                        <span class="b2b-architecture-tile__value">{{ phpstan.isVerified() ? phpstan.value : unavailable }}</span>
                        <span class="b2b-architecture-tile__label">{{ 'tiles.phpstan_label'|trans({}, 'architecture') }}</span>
                        <span class="b2b-architecture-tile__note">{{ 'tiles.phpstan_note'|trans({}, 'architecture') }}</span>
                    </li>
                    <li class="b2b-architecture-tile" data-architecture-quality-tile>
                        <span class="b2b-architecture-tile__value">{{ tests.isVerified() ? tests.value : unavailable }}</span>
                        <span class="b2b-architecture-tile__label">{{ 'figures.tests'|trans({}, 'architecture') }}</span>
                        <span class="b2b-architecture-tile__note">{{ 'tiles.tests_note'|trans({}, 'architecture') }}</span>
                    </li>
                    {% if show_ci %}
                        <li class="b2b-architecture-tile" data-architecture-quality-tile data-architecture-ci>
                            <span class="b2b-architecture-tile__value">{{ ('quality.ci_status.' ~ ci.value)|trans({}, 'architecture')|capitalize }}</span>
                            <span class="b2b-architecture-tile__label">{{ 'tiles.ci_label'|trans({}, 'architecture') }}</span>
                            <span class="b2b-architecture-tile__note">{{ 'tiles.ci_note'|trans({}, 'architecture') }} {% include 'shared/_external_link.html.twig' with { url: ci.source, label: 'quality.ci_link'|trans({}, 'architecture')|capitalize } only %}</span>
                        </li>
                    {% endif %}
                </ul>
                <ul class="b2b-architecture-points b2b-architecture-points--single">
                    <li>{{ 'quality.gates'|trans({'%phpstan%': phpstan.isVerified() ? phpstan.value : unavailable}, 'architecture') }}</li>
                    <li>{{ 'quality.tests'|trans({'%tests%': tests.isVerified() ? tests.value : unavailable}, 'architecture') }}</li>
                    <li>{{ 'quality.supply_chain'|trans({}, 'architecture') }}</li>
                </ul>
                <p class="b2b-architecture-inline">
                    {{ 'quality.proof'|trans({'%date%': report.generatedAt ? report.generatedAt|slice(0, 10) : unavailable}, 'architecture') }}
                    <a href="{{ path('app_demo_proof', {_locale: app.request.locale}) }}" data-architecture-proof-link>{{ 'quality.proof_link'|trans({}, 'architecture') }}</a>
                </p>
                {{ page.links({'blob/main/.github/workflows/ci.yaml': 'links.ci', 'blob/main/phpstan.dist.neon': 'links.phpstan', 'blob/main/docs/tests-locaux.md': 'links.tests'}, repository) }}
            </section>

            <section class="b2b-architecture-section" data-architecture-section="security" aria-labelledby="architecture-security">
                <div class="b2b-architecture-section__head"><h2 class="b2b-home-h2" id="architecture-security" tabindex="-1">{{ 'security.title'|trans({}, 'architecture') }}</h2></div>
                <p class="b2b-architecture-inline">{{ 'security.intro'|trans({}, 'architecture') }}</p>
                <ul class="b2b-architecture-points" data-architecture-visual>
                    {% for item in ['data', 'accounts', 'outbound', 'abuse', 'headers', 'dependencies'] %}
                        <li data-architecture-principle>{{ ('security.' ~ item)|trans({}, 'architecture') }}</li>
                    {% endfor %}
                </ul>
                {{ page.links({'blob/main/docs/adr/0008-securite-de-la-demo-publique.md': 'links.adr_security'}, repository) }}
            </section>

            <section class="b2b-architecture-section" data-architecture-section="mockups" aria-labelledby="architecture-mockups">
                <div class="b2b-architecture-section__head"><h2 class="b2b-home-h2" id="architecture-mockups" tabindex="-1">{{ 'mockups.title'|trans({}, 'architecture') }}</h2></div>
                <p class="b2b-architecture-inline">{{ 'mockups.intro'|trans({}, 'architecture') }}</p>
                <ol class="b2b-architecture-cards b2b-architecture-cards--two" data-architecture-visual>
                    <li class="b2b-architecture-card b2b-architecture-card--mockup" data-architecture-mockup data-test="mockup-copilote">
                        <h3>{{ 'mockups.copilote.name'|trans({}, 'architecture') }}</h3>
                        <img src="{{ asset('images/mockups/copilote-desktop.jpg') }}" width="1280" height="698" alt="{{ 'mockups.copilote.alt'|trans({}, 'architecture') }}" loading="lazy" decoding="async">
                        <p>{{ 'mockups.copilote.text'|trans({}, 'architecture') }}</p>
                    </li>
                    <li class="b2b-architecture-card b2b-architecture-card--mockup" data-architecture-mockup data-test="mockup-reassort">
                        <h3>{{ 'mockups.reassort.name'|trans({}, 'architecture') }}</h3>
                        <img src="{{ asset('images/mockups/reassort-desktop.jpg') }}" width="1280" height="698" alt="{{ 'mockups.reassort.alt'|trans({}, 'architecture') }}" loading="lazy" decoding="async">
                        <p>{{ 'mockups.reassort.text'|trans({}, 'architecture') }}</p>
                    </li>
                </ol>
                <p class="b2b-architecture-inline">{{ 'mockups.process'|trans({}, 'architecture') }}</p>
                {{ page.links({'blob/main/docs/conception-graphique.md': 'links.design_doc'}, repository) }}
            </section>
        </div>

        <section class="b2b-home-night b2b-architecture-closing" aria-labelledby="architecture-closing-title">
            <div class="b2b-home-wrap">
                <div class="b2b-architecture-closing__body">
                    <h2 id="architecture-closing-title" class="b2b-home-h2">{{ 'closing.title'|trans({}, 'architecture') }}</h2>
                    <p>{{ 'closing.text'|trans({}, 'architecture') }}</p>
                </div>
                {% include 'shared/_contact_cta.html.twig' with { variant: 'dark', placement: 'architecture-bottom' } only %}
            </div>
        </section>
    </div>
{% endblock %}
