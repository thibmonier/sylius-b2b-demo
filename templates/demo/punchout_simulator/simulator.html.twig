{% trans_default_domain 'simulator' %}
{% set protocol = protocol|default('cxml') %}
{% set home = protocol == 'oci' ? 'app_demo_punchout_simulator_oci' : 'app_demo_punchout_simulator' %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'title'|trans({}, 'simulator', locale) }} — Fournitures Pro</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; }
        h1, h2 { color: #1f3a5f; }
        table { width: 100%; border-collapse: collapse; margin: .75rem 0; }
        th, td { text-align: left; padding: .5rem .75rem; border: 1px solid #ddd; }
        th { background: #f0f4f8; }
        code { background: #f0f4f8; padding: .1rem .4rem; border-radius: 3px; font-size: .9em; overflow-wrap: anywhere; }
        .note { background: #fff8e1; border-left: 4px solid #f59e0b; padding: .75rem 1rem; margin: 1rem 0; border-radius: 3px; }
        .error { background: #fdecea; border-left: 4px solid #c0392b; padding: .75rem 1rem; margin: 1rem 0; border-radius: 3px; }
        .success { background: #e8f5e9; border-left: 4px solid #2e7d32; padding: .75rem 1rem; margin: 1rem 0; border-radius: 3px; }
        fieldset { border: 1px solid #ddd; margin: 1rem 0; }
        label { display: block; margin: .4rem 0; }
        button { background: #1f3a5f; color: #fff; border: 0; padding: .6rem 1.2rem; border-radius: 4px; font-size: 1rem; cursor: pointer; }
        button:focus-visible, a:focus-visible, input:focus-visible { outline: 3px solid #f59e0b; outline-offset: 2px; }
        .num { text-align: right; }
        .portal { display: flex; align-items: center; gap: .75rem; background: #1f3a5f; color: #fff; padding: .75rem 1rem; border-radius: 4px; margin-bottom: 1rem; }
        .portal strong { font-size: 1.1rem; }
        .portal small { display: block; }
        .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: .75rem; list-style: none; padding: 0; margin: 1rem 0; counter-reset: step; }
        .steps li { border: 2px solid #5b6b7f; border-radius: 4px; padding: .75rem; counter-increment: step; background: #fff; }
        .steps li::before { content: counter(step); display: inline-flex; align-items: center; justify-content: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: #1f3a5f; color: #fff; font-weight: 700; margin-right: .5rem; }
        .steps li[aria-current="step"] { border-color: #1f3a5f; border-width: 4px; background: #f0f4f8; }
        .steps p { margin: .25rem 0 0; }
        .help { position: relative; display: inline-block; border-bottom: 2px dotted #1f3a5f; cursor: help; font-weight: 600; margin-right: 1rem; }
        .help .def { display: none; position: absolute; left: 0; top: 100%; z-index: 2; width: 18rem; max-width: 80vw; background: #1f3a5f; color: #fff; padding: .5rem .75rem; border-radius: 4px; font-size: .9rem; font-weight: 400; }
        .help:hover .def, .help:focus .def, .help:focus-within .def { display: block; }
        .help:focus-visible { outline: 3px solid #f59e0b; outline-offset: 2px; }
        input[type="url"], input[name="orderId"] { width: 100%; max-width: 100%; box-sizing: border-box; min-height: 2.75rem; }
        .vh { position: absolute; left: -9999px; }
        .flow { width: 100%; max-width: 46rem; height: auto; color: #1a1a1a; }
        .cta a { display: inline-flex; align-items: center; min-height: 2.75rem; margin-right: 1.5rem; color: #1f3a5f; }
    </style>
</head>
<body>
{% include 'shared/_umami.html.twig' %}
<main>
<p><a href="{{ path(home, {lang: locale == 'fr' ? 'en' : 'fr'}) }}" lang="{{ locale == 'fr' ? 'en' : 'fr' }}">{{ 'switch_language'|trans({}, 'simulator', locale) }}</a></p>

<div class="portal" data-simulator-portal>
    <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><rect width="40" height="40" rx="8" fill="#fff"/><path d="M10 28V12h9a6 6 0 0 1 0 12h-5" fill="none" stroke="#1f3a5f" stroke-width="3"/></svg>
    <div><strong>{{ 'portal.name'|trans({}, 'simulator', locale) }}</strong><small>{{ 'portal.note'|trans({}, 'simulator', locale) }}</small></div>
</div>

<h1>{{ 'title'|trans({}, 'simulator', locale) }}</h1>
<nav aria-label="{{ 'protocol.label'|trans({}, 'simulator', locale) }}">
    <a href="{{ path('app_demo_punchout_simulator', {lang: locale}) }}"{% if protocol == 'cxml' %} aria-current="page"{% endif %}>{{ 'protocol.cxml'|trans({}, 'simulator', locale) }}</a> ·
    <a href="{{ path('app_demo_punchout_simulator_oci', {lang: locale}) }}"{% if protocol == 'oci' %} aria-current="page"{% endif %}>{{ 'protocol.oci'|trans({}, 'simulator', locale) }}</a>
</nav>
<p>{{ (protocol == 'oci' ? 'oci.intro' : 'intro')|trans({}, 'simulator', locale) }}</p>

<h2>{{ 'steps.title'|trans({}, 'simulator', locale) }}</h2>
<ol class="steps" data-simulator-steps>
    {% for number in 1..4 %}
        <li{% if number == step %} aria-current="step"{% endif %}>
            <strong>{{ ('steps.s' ~ number ~ '.title')|trans({}, 'simulator', locale) }}</strong>{% if number < step %}<span class="vh"> ({{ 'steps.done'|trans({}, 'simulator', locale) }})</span>{% endif %}
            <p>{{ ('steps.s' ~ number ~ '.text' ~ (number == 4 and protocol == 'oci' ? '_oci' : ''))|trans({}, 'simulator', locale) }}</p>
        </li>
    {% endfor %}
</ol>

<p><strong>{{ 'vocabulary.title'|trans({}, 'simulator', locale) }}</strong>
    {% for term in ['cxml', 'oci', 'order_request', 'hook_url'] %}
        <span class="help" tabindex="0" data-simulator-term="{{ term }}" aria-describedby="simulator-def-{{ term }}">{{ ('vocabulary.' ~ term ~ '.label')|trans({}, 'simulator', locale) }}<span class="def" role="tooltip" id="simulator-def-{{ term }}">{{ ('vocabulary.' ~ term ~ '.definition')|trans({}, 'simulator', locale) }}</span></span>
    {% endfor %}
</p>

<svg class="flow" viewBox="0 0 760 110" role="img" aria-labelledby="simulator-flow-title simulator-flow-desc" data-simulator-flow xmlns="http://www.w3.org/2000/svg">
    <title id="simulator-flow-title">{{ 'flow.title'|trans({}, 'simulator', locale) }}</title>
    <desc id="simulator-flow-desc">{{ 'flow.desc'|trans({}, 'simulator', locale) }}</desc>
    <defs><marker id="simulator-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0L10 5L0 10z" fill="currentColor"/></marker></defs>
    <g fill="none" stroke="currentColor" stroke-width="2">
        {% for index in 0..3 %}<rect x="{{ 5 + index * 190 }}" y="20" width="150" height="70" rx="6"/>{% endfor %}
        {% for index in 0..2 %}<line x1="{{ 155 + index * 190 }}" y1="55" x2="{{ 193 + index * 190 }}" y2="55" marker-end="url(#simulator-arrow)"/>{% endfor %}
    </g>
    <g fill="currentColor" font-size="14" text-anchor="middle">
        {% for index in 0..3 %}<text x="{{ 80 + index * 190 }}" y="60">{{ ('flow.s' ~ (index + 1))|trans({}, 'simulator', locale) }}</text>{% endfor %}
    </g>
</svg>

{% if error is defined %}
    <div class="error" role="alert">
        <strong>{{ ('error.' ~ error.key)|trans({'%host%': host, '%domains%': domains|join(', ')}, 'simulator', locale) }}</strong>
        {% if error.detail is defined and error.detail != '' %}<br><code>{{ error.status }} — {{ error.detail }}</code>{% endif %}
        {% if error.key in ['session_expired', 'already_sent', 'return_replayed', 'csrf'] %}<br><a href="{{ path(home, {lang: locale}) }}" data-simulator-restart>{{ 'restart'|trans({}, 'simulator', locale) }}</a>{% endif %}
    </div>
{% endif %}

{% if sent is defined %}
    <div class="success" role="status">
        <strong>{{ 'sent.title'|trans({}, 'simulator', locale) }}</strong><br>
        {{ 'sent.po'|trans({'%po%': sent.orderId}, 'simulator', locale) }}<br>
        <code>{{ sent.message }}</code>
    </div>
{% endif %}

{% if cart is defined %}
    <h2>{{ 'cart.title'|trans({}, 'simulator', locale) }}</h2>
    {% if received is defined %}
        <div class="success" role="status">{{ 'oci.received'|trans({}, 'simulator', locale) }}</div>
    {% endif %}
    {% if cart.lines is empty %}
        <div class="note" role="status">{{ 'cart.empty'|trans({}, 'simulator', locale) }}</div>
    {% endif %}
    <table>
        <caption class="sr-only" style="position:absolute;left:-9999px">{{ 'cart.title'|trans({}, 'simulator', locale) }}</caption>
        <thead>
            <tr>
                <th scope="col">{{ 'cart.part'|trans({}, 'simulator', locale) }}</th>
                <th scope="col">{{ 'cart.description'|trans({}, 'simulator', locale) }}</th>
                <th scope="col" class="num">{{ 'cart.quantity'|trans({}, 'simulator', locale) }}</th>
                <th scope="col" class="num">{{ 'cart.unit_price'|trans({}, 'simulator', locale) }}</th>
            </tr>
        </thead>
        <tbody>
        {% for line in cart.lines %}
            <tr>
                <td><code>{{ line.supplierPartId }}</code></td>
                <td>{{ line.description }}</td>
                <td class="num">{{ line.quantity }} {{ line.unitOfMeasure }}</td>
                <td class="num">{{ line.unitPrice }} {{ line.currency }}</td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
            <tr><th scope="row" colspan="3">{{ 'cart.total'|trans({}, 'simulator', locale) }}</th><td class="num">{{ cart.total }} {{ cart.currency }}</td></tr>
        </tfoot>
    </table>

    {% if state is defined and sent is not defined %}
        <form method="post" action="{{ path('app_demo_punchout_simulator_order', {lang: locale}) }}">
            <input type="hidden" name="_token" value="{{ csrf_order }}">
            <input type="hidden" name="state" value="{{ state }}">
            <label for="orderId">{{ 'order.id_label'|trans({}, 'simulator', locale) }}</label>
            <input id="orderId" name="orderId" value="{{ orderId|default('') }}" maxlength="64" pattern="[A-Za-z0-9\-]+" required>
            <p><button type="submit">{{ 'order.send'|trans({}, 'simulator', locale) }}</button></p>
        </form>
    {% endif %}
{% endif %}

{% if cart is not defined and protocol == 'oci' %}
    <div class="note">
        {{ 'buyer.info'|trans({'%domains%': domains|join(', ')}, 'simulator', locale) }}
    </div>
    <form method="post" action="{{ path('app_demo_punchout_simulator_oci_start', {lang: locale}) }}">
        <input type="hidden" name="_token" value="{{ csrf }}">
        <p>
            <label for="hook-url">{{ 'oci.hook_url'|trans({}, 'simulator', locale) }}</label>
            <input id="hook-url" name="HOOK_URL" type="url" value="{{ hookUrl }}" size="70" maxlength="2000" required aria-describedby="hook-url-help">
        </p>
        <p id="hook-url-help">{{ 'oci.hook_url_help'|trans({}, 'simulator', locale) }}</p>
        <fieldset>
            <legend>{{ 'errors.legend'|trans({}, 'simulator', locale) }}</legend>
            <label><input type="checkbox" name="wrong_secret" value="1"> {{ 'oci.wrong_password'|trans({}, 'simulator', locale) }}</label>
        </fieldset>
        <button type="submit"{{ app_umami_event('simulateur-punchout-lancement', { protocole: 'oci' }) }}>{{ 'oci.start'|trans({}, 'simulator', locale) }}</button>
    </form>
{% elseif cart is not defined %}
    <div class="note">
        {{ 'buyer.info'|trans({'%domains%': domains|join(', ')}, 'simulator', locale) }}
    </div>
    <form method="post" action="{{ path('app_demo_punchout_simulator_start', {lang: locale}) }}">
        <input type="hidden" name="_token" value="{{ csrf }}">
        <fieldset>
            <legend>{{ 'errors.legend'|trans({}, 'simulator', locale) }}</legend>
            <label><input type="checkbox" name="wrong_secret" value="1"> {{ 'errors.wrong_secret'|trans({}, 'simulator', locale) }}</label>
            <label><input type="checkbox" name="foreign_domain" value="1"> {{ 'errors.foreign_domain'|trans({}, 'simulator', locale) }}</label>
        </fieldset>
        <button type="submit"{{ app_umami_event('simulateur-punchout-lancement', { protocole: 'cxml' }) }}>{{ 'start'|trans({}, 'simulator', locale) }}</button>
    </form>
{% endif %}
{% if app_demo_cta_targets('punchout-simulator') %}
    <p class="cta"><strong>{{ 'cta.card.title'|trans({}, 'theme_demo', locale) }}</strong><br>{% include 'shared/_contact_cta.html.twig' with { variant: 'link', placement: 'punchout-simulator', locale: locale } only %}</p>
{% endif %}
</main>
</body>
</html>
