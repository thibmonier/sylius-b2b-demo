<div class="card mt-4" data-demo-accounts="{{ scope }}">
    <div class="card-header">Comptes de démo / Demo accounts</div>
    <ul class="list-group list-group-flush">
        {% for account in accounts %}
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <strong>{{ account.fullName }}</strong>
                    <span class="text-muted small">— {{ account.roleLabel }}{% if account.companyName %}, {{ account.companyName }}{% endif %}</span><br>
                    <code>{{ account.email }}</code> / <code>{{ account.password }}</code>
                    {% if not account.enabled %}<span class="badge bg-danger">désactivé / disabled</span>{% endif %}
                </div>
                {% include 'demo/_login_form.html.twig' with { account, check_route, csrf_field, csrf_id } only %}
            </li>
        {% endfor %}
    </ul>
</div>
