{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'title'|trans({}, 'integrate') }}{% endblock %}

{% block content %}
    {# US-107: Bootstrap utilities only (the page also shows on the B2C channel). A self-service technical guide: no price, no comparison, no offer. #}
    <div class="container my-5" data-page="integrate">
        <h1>{{ 'title'|trans({}, 'integrate') }}</h1>
        <p class="lead">{{ 'intro'|trans({}, 'integrate') }}</p>

        <section class="mt-5" aria-labelledby="integrate-prerequisites">
            <h2 class="h4 border-bottom pb-2" id="integrate-prerequisites">{{ 'prerequisites.title'|trans({}, 'integrate') }}</h2>
            <ul class="mt-3" data-integrate-prerequisites>
                {% for item in ['sylius', 'php', 'symfony', 'composer'] %}
                    <li>{{ ('prerequisites.' ~ item)|trans({}, 'integrate') }}</li>
                {% endfor %}
            </ul>
        </section>

        <section class="mt-5" aria-labelledby="integrate-install">
            <h2 class="h4 border-bottom pb-2" id="integrate-install">{{ 'install.title'|trans({}, 'integrate') }}</h2>
            <p>{{ 'install.intro'|trans({}, 'integrate') }}</p>
            {% set snippets = {
                require: 'composer require tmonier/sylius-quick-order-plugin',
                bundle: "// config/bundles.php\nTmonier\\SyliusQuickOrderPlugin\\TmonierSyliusQuickOrderPlugin::class => ['all' => true],",
                config: "imports:\n    - { resource: \"@TmonierSyliusQuickOrderPlugin/config/config.yaml\" }",
                routes: "tmonier_sylius_quick_order:\n    resource: \"@TmonierSyliusQuickOrderPlugin/config/routes.yaml\"",
                migrations: 'bin/console doctrine:migrations:migrate',
                assets: "bin/console assets:install\nbin/console cache:clear",
            } %}
            <ol class="ps-3" data-integrate-install>
                {% for step, snippet in snippets %}
                    <li class="mb-3" data-integrate-step="{{ step }}">
                        <p class="fw-semibold mb-1" style="overflow-wrap: anywhere">{{ ('install.' ~ step ~ '.title')|trans({}, 'integrate') }}</p>
                        <pre class="border rounded p-3 mb-1" style="white-space: pre-wrap; word-break: break-all" tabindex="0"><code style="white-space: inherit; word-break: inherit">{{ snippet }}</code></pre>
                        {% if ('install.' ~ step ~ '.text')|trans({}, 'integrate') != 'install.' ~ step ~ '.text' %}
                            <p class="mb-0">{{ ('install.' ~ step ~ '.text')|trans({}, 'integrate') }}</p>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>
        </section>

        <section class="mt-5" aria-labelledby="integrate-questions">
            <h2 class="h4 border-bottom pb-2" id="integrate-questions">{{ 'questions.title'|trans({}, 'integrate') }}</h2>
            <div class="mt-3 d-grid gap-2">
                {% for question in ['erp', 'punchout', 'e-invoicing', 'volume'] %}
                    <details class="border rounded px-3" data-integrate-question="{{ question }}">
                        <summary class="py-2 fw-semibold d-flex align-items-center" style="min-height: 2.75rem; cursor: pointer">{{ ('questions.' ~ question ~ '.summary')|trans({}, 'integrate') }}</summary>
                        <p class="pb-2 mb-0">{{ ('questions.' ~ question ~ '.text')|trans({}, 'integrate') }}</p>
                    </details>
                {% endfor %}
            </div>
        </section>

        <section class="mt-5" aria-labelledby="integrate-architecture">
            <h2 class="h4 border-bottom pb-2" id="integrate-architecture">{{ 'architecture.title'|trans({}, 'integrate') }}</h2>
            <p>{{ 'architecture.intro'|trans({}, 'integrate') }}</p>
            <figure class="mb-0">
                <svg class="w-100 border rounded p-2" style="max-width: 36rem; height: auto" viewBox="0 0 520 360" role="img" aria-labelledby="integrate-figure-title integrate-figure-desc" data-integrate-architecture xmlns="http://www.w3.org/2000/svg">
                    <title id="integrate-figure-title">{{ 'architecture.figure_title'|trans({}, 'integrate') }}</title>
                    <desc id="integrate-figure-desc">{{ 'architecture.figure_desc'|trans({}, 'integrate') }}</desc>
                    <defs>
                        <marker id="integrate-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="currentColor"/></marker>
                    </defs>
                    <g fill="none" stroke="currentColor" stroke-width="2" font-family="inherit" font-size="14">
                        <rect x="10" y="10" width="230" height="70" rx="6"/>
                        <rect x="280" y="10" width="230" height="70" rx="6"/>
                        <rect x="10" y="280" width="230" height="70" rx="6"/>
                        <rect x="280" y="280" width="230" height="70" rx="6"/>
                        <rect x="100" y="140" width="320" height="80" rx="6" stroke-width="4"/>
                        <line x1="125" y1="80" x2="170" y2="138" marker-end="url(#integrate-arrow)"/>
                        <line x1="395" y1="80" x2="350" y2="138" marker-end="url(#integrate-arrow)"/>
                        <line x1="125" y1="280" x2="170" y2="222" marker-start="url(#integrate-arrow)" marker-end="url(#integrate-arrow)"/>
                        <line x1="395" y1="222" x2="395" y2="278" marker-end="url(#integrate-arrow)"/>
                    </g>
                    <g fill="currentColor" font-size="15" text-anchor="middle">
                        <text x="125" y="50">{{ 'architecture.punchout'|trans({}, 'integrate') }}</text>
                        <text x="395" y="50">{{ 'architecture.mcp'|trans({}, 'integrate') }}</text>
                        <text x="260" y="186" font-weight="700">{{ 'architecture.shop'|trans({}, 'integrate') }}</text>
                        <text x="125" y="320">{{ 'architecture.erp'|trans({}, 'integrate') }}</text>
                        <text x="395" y="320">{{ 'architecture.invoicing'|trans({}, 'integrate') }}</text>
                    </g>
                </svg>
                <figcaption class="mt-2">{{ 'architecture.caption'|trans({}, 'integrate') }}</figcaption>
            </figure>
        </section>


        <section class="mt-5" aria-labelledby="integrate-integrations">
            <h2 class="h4 border-bottom pb-2" id="integrate-integrations">{{ 'integrations.title'|trans({}, 'integrate') }}</h2>
            <p>{{ 'integrations.intro'|trans({}, 'integrate') }}</p>
            <ul class="list-unstyled row row-cols-1 row-cols-md-2 g-3 mb-0" data-integrations>
                {% for integration in integrations %}
                    <li class="col" data-integration="{{ integration.id }}" data-integration-state="{{ integration.state }}">
                        <div class="border rounded p-3 h-100">
                            <p class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <span class="fw-semibold">{{ ('integrations.items.' ~ integration.id ~ '.name')|trans({}, 'integrate') }}</span>
                                <span class="badge bg-white text-dark border border-2 {{ {available: 'border-success', in_progress: 'border-primary', upcoming: 'border-primary', not_provided: 'border-dark'}[integration.state] }}" data-integration-state-label>{{ ('integrations.state.' ~ integration.state)|trans({}, 'integrate') }}</span>
                            </p>
                            <p class="mb-2">{{ ('integrations.items.' ~ integration.id ~ '.text')|trans({}, 'integrate') }}</p>
                            {% if integration.plugin %}
                                <p class="mb-0">{{ 'integrations.plugin'|trans({}, 'integrate') }} {% include 'shared/_external_link.html.twig' with { url: integration.plugin.githubUrl, label: integration.plugin.name, data_attribute: 'data-integration-plugin' } only %}</p>
                            {% elseif integration.contract %}
                                <p class="mb-0">{{ 'integrations.not_provided_note'|trans({}, 'integrate') }} {% include 'shared/_external_link.html.twig' with { url: integration.contract.githubUrl ~ '#readme', label: 'integrations.contract'|trans({'%plugin%': integration.contract.name}, 'integrate'), data_attribute: 'data-integration-contract' } only %}</p>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>

        <section class="mt-5" aria-labelledby="integrate-repositories">
            <h2 class="h4 border-bottom pb-2" id="integrate-repositories">{{ 'repositories.title'|trans({}, 'integrate') }}</h2>
            <p>{{ 'repositories.intro'|trans({}, 'integrate') }}</p>
            <ul class="list-unstyled row row-cols-1 row-cols-md-2 g-2 mb-0">
                {% for plugin in plugins %}
                    <li class="col" data-integrate-repository="{{ plugin.slug }}">
                        <div class="border rounded p-2 h-100">
                            <p class="fw-semibold mb-1">{{ plugin.name }}</p>
                            <p class="mb-1" style="overflow-wrap: anywhere"><code>{{ plugin.composerName }}</code></p>
                            <p class="mb-0 d-flex flex-wrap gap-3">
                                {% include 'shared/_external_link.html.twig' with { url: plugin.githubUrl, label: 'repositories.github'|trans({}, 'integrate'), data_attribute: 'data-integrate-github' } only %}
                                {% include 'shared/_external_link.html.twig' with { url: plugin.githubUrl ~ '#readme', label: 'repositories.readme'|trans({}, 'integrate'), data_attribute: 'data-integrate-readme' } only %}
                            </p>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
    </div>
{% endblock %}
