{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'title'|trans({}, 'proof') }}{% endblock %}

{% block content %}
    <style>
        [data-proof-table] time { white-space: nowrap; }
        @media (max-width: 767.98px) {
            [data-proof-table] thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
            [data-proof-table] tr { display: block; margin-bottom: 1rem; padding: .5rem .75rem; border: 1px solid var(--bs-border-color, #dee2e6); border-radius: .375rem; }
            [data-proof-table] th, [data-proof-table] td { display: block; padding: .25rem 0; border: 0; overflow-wrap: anywhere; }
            [data-proof-table] td::before { content: attr(data-label); display: block; font-weight: 600; font-size: .875rem; }
        }
    </style>
    <div class="container my-5" data-page="proof">
        <h1>{{ 'title'|trans({}, 'proof') }}</h1>
        <p class="lead">{{ 'intro'|trans({'%count%': plugins|length}, 'proof') }}</p>
        <p data-proof-generated>
            {% if report.generatedAt %}{{ 'generated'|trans({'%date%': report.generatedAt|slice(0, 10)}, 'proof') }} {% endif %}{{ 'generated_note'|trans({}, 'proof') }}
        </p>

        <section class="mt-5" data-proof-delivery aria-labelledby="proof-delivery-title">
            <h2 class="h4 border-bottom pb-2 b2b-section-title" id="proof-delivery-title">{{ 'delivery.title'|trans({}, 'proof') }}</h2>
            <p>{{ 'delivery.intro'|trans({}, 'proof') }}</p>
            <ul class="list-unstyled d-grid gap-2">
                {% for key in ['tests', 'phpstan', 'ecs', 'composer_audit', 'image_scan', 'sbom', 'ci'] %}
                    {% set fact = report.deliveryFact(key) %}
                    {% if key == 'tests' %}
                        {% set text = 'tests_count'|trans({'%count%': fact.value}, 'proof') %}
                    {% elseif key == 'phpstan' %}
                        {% set text = 'delivery.phpstan_level'|trans({'%level%': fact.value}, 'proof') %}
                    {% elseif key == 'ci' %}
                        {% set text = ('ci.' ~ fact.value)|trans({}, 'proof') %}
                    {% else %}
                        {% set text = fact.value %}
                    {% endif %}
                    <li data-proof-delivery-item="{{ key }}">
                        <strong>{{ ('delivery.item.' ~ key)|trans({}, 'proof') }}</strong> :
                        {% include 'demo/proof/_fact.html.twig' with { fact: fact, text: text } only %}
                    </li>
                {% endfor %}
            </ul>
        </section>

        <section class="mt-5" aria-labelledby="proof-plugins-title">
            <h2 class="h4 border-bottom pb-2 b2b-section-title" id="proof-plugins-title">{{ 'plugins.title'|trans({}, 'proof') }}</h2>
            <p>{{ 'legend'|trans({}, 'proof') }}</p>
            <table class="table align-top" data-proof-table role="table">
                <caption class="visually-hidden">{{ 'plugins.caption'|trans({}, 'proof') }}</caption>
                <thead role="rowgroup">
                    <tr role="row">
                        {% for column in ['plugin', 'version', 'sylius', 'ci', 'phpstan', 'tests', 'coverage'] %}
                            <th scope="col" role="columnheader">{{ ('plugins.column.' ~ column)|trans({}, 'proof') }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody role="rowgroup">
                    {% for plugin in plugins %}
                        {% set slug = plugin.slug %}
                        {% set version = report.fact(slug, 'version') %}
                        {% set compat = report.fact(slug, 'sylius_23') %}
                        {% set declared = report.fact(slug, 'sylius_declared') %}
                        {% set tested = report.fact(slug, 'sylius_tested') %}
                        {% set ci = report.fact(slug, 'ci') %}
                        {% set phpstan = report.fact(slug, 'phpstan') %}
                        {% set tests = report.fact(slug, 'tests') %}
                        {% set coverage = report.fact(slug, 'coverage') %}
                        <tr data-plugin="{{ slug }}" role="row">
                            <th scope="row" role="rowheader" class="fw-bold"><a href="{{ path('app_demo_plugins', {_locale: app.request.locale}) }}#plugin-{{ slug }}">{{ plugin.name }}</a></th>
                            <td data-proof-cell="version" data-label="{{ 'plugins.column.version'|trans({}, 'proof') }}" role="cell">
                                {% include 'demo/proof/_fact.html.twig' with { fact: version, text: version.value } only %}
                            </td>
                            <td data-proof-cell="sylius" data-label="{{ 'plugins.column.sylius'|trans({}, 'proof') }}" role="cell">
                                {% if compat.status == 'verified' %}
                                    {% set answer = (compat.value ? 'answer.yes' : 'answer.no')|trans({}, 'proof') %}
                                    {% set compat_text = declared.status == 'verified' ? 'sylius.compat_constraint'|trans({'%answer%': answer, '%constraint%': declared.value}, 'proof') : 'sylius.compat'|trans({'%answer%': answer}, 'proof') %}
                                {% else %}
                                    {% set compat_text = '' %}
                                {% endif %}
                                <div>{% include 'demo/proof/_fact.html.twig' with { fact: compat, text: compat_text } only %}</div>
                                {% if tested.status == 'verified' or compat.status == 'verified' %}
                                    <div class="mt-1">{% include 'demo/proof/_fact.html.twig' with { fact: tested, text: tested.status == 'verified' ? 'sylius.tested'|trans({'%versions%': tested.value}, 'proof') : '' } only %}</div>
                                {% endif %}
                            </td>
                            <td data-proof-cell="ci" data-label="{{ 'plugins.column.ci'|trans({}, 'proof') }}" role="cell">
                                {% include 'demo/proof/_fact.html.twig' with { fact: ci, text: ci.status == 'verified' ? ('ci.' ~ ci.value)|trans({}, 'proof') : '' } only %}
                            </td>
                            <td data-proof-cell="phpstan" data-label="{{ 'plugins.column.phpstan'|trans({}, 'proof') }}" role="cell">
                                {% include 'demo/proof/_fact.html.twig' with { fact: phpstan, text: 'phpstan_level'|trans({'%level%': phpstan.value}, 'proof') } only %}
                            </td>
                            <td data-proof-cell="tests" data-label="{{ 'plugins.column.tests'|trans({}, 'proof') }}" role="cell">
                                {% include 'demo/proof/_fact.html.twig' with { fact: tests, text: 'tests_count'|trans({'%count%': tests.value}, 'proof') } only %}
                            </td>
                            <td data-proof-cell="coverage" data-label="{{ 'plugins.column.coverage'|trans({}, 'proof') }}" role="cell">
                                {% include 'demo/proof/_fact.html.twig' with { fact: coverage, text: coverage.value ~ ' %' } only %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </div>
{% endblock %}
