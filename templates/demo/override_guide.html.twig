{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'title'|trans({}, 'override_guide') }}{% endblock %}

{#
    US-172: how to adapt a plugin without modifying it. Bootstrap utilities only (the page also shows on the B2C channel).
    The excerpts are read from the files themselves (registry config/packages/demo_override_guide.yaml), so they cannot
    drift from the repository; a test fails when a cited file or line range disappears.
#}
{% set repository = 'https://github.com/thibmonier/sylius-b2b-demo/blob/main/' %}

{% macro example(item, excerpt, repository) %}
    <h3 class="h6 mt-3">{{ 'labels.example'|trans({}, 'override_guide') }} : <code style="overflow-wrap: anywhere">{{ item.path }}</code></h3>
    <pre class="border rounded p-3 mb-1" style="white-space: pre-wrap; word-break: break-all" tabindex="0"><code style="white-space: inherit; word-break: inherit">{{ excerpt }}</code></pre>
    <p class="mb-2">{% include 'shared/_external_link.html.twig' with { url: repository ~ item.path ~ '#L' ~ item.firstLine ~ '-L' ~ item.lastLine, label: 'labels.source'|trans({'%first%': item.firstLine, '%last%': item.lastLine}, 'override_guide'), data_attribute: 'data-override-source' } only %}</p>
    {% if item.related %}
        <p class="mb-2">{{ 'labels.related'|trans({}, 'override_guide') }} :
            {% for path in item.related %}<code style="overflow-wrap: anywhere">{{ path }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
        </p>
    {% endif %}
    <p class="mb-1 fw-semibold">{{ 'labels.command'|trans({}, 'override_guide') }}</p>
    <pre class="border rounded p-3 mb-0" style="white-space: pre-wrap; word-break: break-all" tabindex="0"><code style="white-space: inherit; word-break: inherit" data-override-command>{{ item.command }}</code></pre>
{% endmacro %}

{% block content %}
    {% import _self as page %}
    <div class="container my-5" data-page="override-guide">
        <h1>{{ 'title'|trans({}, 'override_guide') }}</h1>
        <p class="lead">{{ 'intro'|trans({}, 'override_guide') }}</p>

        {% for item in examples %}
            <section class="mt-5" aria-labelledby="override-{{ item.case }}" data-override-case="{{ item.case }}">
                <h2 class="h4 border-bottom pb-2" id="override-{{ item.case }}">{{ ('cases.' ~ item.case ~ '.name')|trans({}, 'override_guide') }}</h2>
                <p>{{ ('cases.' ~ item.case ~ '.summary')|trans({}, 'override_guide') }}</p>
                <p>{{ ('cases.' ~ item.case ~ '.why')|trans({}, 'override_guide') }}</p>
                {{ page.example(item, excerpts[item.case], repository) }}
                {% if item.case == 'template' %}
                    <p class="mt-3 mb-0"><a href="#override-last-resort">{{ 'cases.template.last_resort_link'|trans({}, 'override_guide') }}</a></p>
                {% endif %}
            </section>
        {% endfor %}

        <section class="mt-5" id="override-last-resort" aria-labelledby="override-last-resort-title" data-override-last-resort>
            <h2 class="h4 border-bottom pb-2" id="override-last-resort-title">{{ 'last_resort.title'|trans({}, 'override_guide') }}</h2>
            <p>{{ 'last_resort.text'|trans({}, 'override_guide') }}</p>
            {{ page.example(last_resort, excerpts['last-resort'], repository) }}
        </section>

        <p class="mt-5 mb-0"><a href="{{ path('app_demo_integrate', {_locale: app.request.locale}) }}">{{ 'labels.back'|trans({}, 'override_guide') }}</a></p>
    </div>
{% endblock %}
